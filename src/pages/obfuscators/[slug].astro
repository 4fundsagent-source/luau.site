---
import DeobfuscatorCard from '~/components/DeobfuscatorCard.astro';
import ExternalLinks from '~/components/ExternalLinks.astro';
import Facts from '~/components/Facts.astro';
import Icon from '~/components/Icon.astro';
import Monogram from '~/components/Monogram.astro';
import ScoreCard from '~/components/ScoreCard.astro';
import Section from '~/components/Section.astro';
import SourcesList from '~/components/SourcesList.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import VersionTable from '~/components/VersionTable.astro';
import Base from '~/layouts/Base.astro';
import { formatDate, formatDuration } from '~/lib/dates';
import { formatVersion, getSiteData, type ObfuscatorView } from '~/lib/data';
import { issueUrl } from '~/lib/site';
import { PRICING_LABEL, RUNTIME_LABEL, STATUS_META, TECHNIQUE_META } from '~/lib/taxonomy';

export async function getStaticPaths() {
  const { obfuscators } = await getSiteData();
  return obfuscators.map((o) => ({ params: { slug: o.id }, props: { o } }));
}

interface Props {
  o: ObfuscatorView;
}
const { o } = Astro.props;
const { deob, samples } = await getSiteData();
const d = o.data;
const s = o.latest.s;
const rank = (await getSiteData()).obfuscators.indexOf(o) + 1;

const headline =
  s.status === 'broken'
    ? `${formatVersion(o.latest.version)} is broken${s.daysToBreak !== undefined ? `, ${formatDuration(s.daysToBreak, s.fuzzy)} after release` : ''}.`
    : s.status === 'partial'
      ? `${formatVersion(o.latest.version)} is partially broken.`
      : `No public deobfuscator is tracked for ${formatVersion(o.latest.version)}.`;

const tools = o.deobfuscators.map((id) => deob.get(id)!);
const runs = samples.flatMap((sm) => sm.runs.filter((r) => r.obfuscator === o.id).map((r) => ({ sample: sm, run: r })));
---

<Base title={d.name} image={`/og/obfuscators/${o.id}.png`} description={`${d.name}: ${d.tagline} ${headline}`}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0" style="background:var(--glow)" aria-hidden="true"></div>
    <div class="container-page relative py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-subtle">
        <a href="/obfuscators" class="hover:text-fg">Obfuscators</a>
        <span aria-hidden="true"> / </span>
        <span class="text-muted">{d.name}</span>
      </nav>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <Monogram name={d.name} id={o.id} size="lg" transitionName={`mono-${o.id}`} />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1 class="text-3xl font-semibold tracking-tight text-fg md:text-4xl">{d.name}</h1>
            <StatusBadge status={o.status} size="md" />
          </div>
          <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-muted">{d.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <span class="chip num">{formatVersion(o.latest.version)}</span>
            <span class="chip">{PRICING_LABEL[d.pricing]}</span>
            {d.targets.map((t) => <span class="chip">{RUNTIME_LABEL[t]}</span>)}
            {d.discontinued && <span class="chip">Discontinued</span>}
          </div>
          <div class="mt-6">
            <ExternalLinks variant="buttons" name={d.name} website={d.website} repo={d.repo} docs={d.docs} discord={d.discord} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-12">
      <div class="surface flex items-start gap-3 p-4 text-sm" style={`border-color:color-mix(in oklab, var(--${o.status}) 30%, var(--line))`}>
        <Icon name={o.status === 'holding' ? 'shield' : 'unlock'} size={18} class="mt-0.5 shrink-0 text-muted" />
        <div>
          <p class="font-medium text-fg">{headline}</p>
          <p class="mt-1 text-muted">{STATUS_META[o.status].description}</p>
        </div>
      </div>

      <Section id="versions" title="Version history" description="Status is derived from the deobfuscators below; nobody types it by hand.">
        <VersionTable versions={o.versions} deob={deob} />
        <a slot="action" href={issueUrl('version-release', { title: `New version: ${d.name}` })} class="text-sm text-muted hover:text-fg">
          Report a new version →
        </a>
      </Section>

      <Section id="deobfuscators" title="Deobfuscators" description={`Tools that target any version of ${d.name}.`}>
        {
          tools.length ? (
            <div class="grid gap-4 md:grid-cols-2">
              {tools.map((t, i) => (
                <DeobfuscatorCard d={t} index={i} />
              ))}
            </div>
          ) : (
            <div class="surface p-6 text-sm text-muted">
              No public deobfuscator is tracked for {d.name}.{' '}
              <a href={issueUrl('new-deobfuscator')} class="link">
                Know one?
              </a>
            </div>
          )
        }
      </Section>

      <Section id="techniques" title="Protection techniques" description="As documented by the vendor or observed in output.">
        <ul class="surface divide-y divide-line">
          {
            d.techniques.map((t) => (
              <li class="flex flex-col gap-1 px-4 py-3 text-sm sm:flex-row sm:gap-4">
                <a href={`/learn#${t}`} class="shrink-0 font-medium text-fg hover:underline sm:w-44">
                  {TECHNIQUE_META[t].label}
                </a>
                <span class="text-muted">{TECHNIQUE_META[t].description}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="lab" title="In the Lab" description="Our own benchmark scripts, run through this obfuscator and every deobfuscator.">
        {
          runs.length ? (
            <ul class="surface divide-y divide-line text-sm">
              {runs.map(({ sample, run }) => (
                <li>
                  <a href={`/lab/${sample.id}/${run.id}`} class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-hover">
                    <span class="text-fg">{sample.meta.title}</span>
                    <span class="num text-muted">
                      {formatVersion(run.version)} · {run.deob.length} deobfuscation{run.deob.length === 1 ? '' : 's'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="surface flex items-start gap-3 p-6 text-sm text-muted">
              <Icon name="flask" size={18} class="shrink-0" />
              <p>
                Not benchmarked yet, so the Lab component of the score gets neutral half credit.{' '}
                <a href="/lab#contribute" class="link">
                  How to add a run
                </a>
              </p>
            </div>
          )
        }
      </Section>

      <Section id="about" title="About">
        <p class="max-w-prose leading-relaxed text-muted">{d.description}</p>
      </Section>

      <Section id="sources" title="Sources & verification">
        <SourcesList
          sources={d.sources}
          verified={d.verified}
          lastVerified={d.lastVerified}
          stale={o.stale}
          file={`src/data/obfuscators/${o.id}.yaml`}
          name={d.name}
        />
      </Section>
    </div>

    <aside class="order-first space-y-4 lg:sticky lg:top-20 lg:order-none lg:self-start">
      <ScoreCard score={o.score} />
      <Facts
        items={[
          { label: 'Rank', value: `#${rank} of ${(await getSiteData()).obfuscators.length}`, href: '/rankings' },
          { label: 'Vendor', value: d.vendor },
          { label: 'Since', value: d.since },
          { label: 'Pricing', value: PRICING_LABEL[d.pricing] },
          { label: 'License', value: d.license },
          { label: 'Versions tracked', value: o.versions.length },
          { label: 'Latest release', value: s.released ? formatDate(s.released) : undefined },
          { label: 'Broken on', value: s.brokenOn ? formatDate(s.brokenOn) : undefined },
        ]}
      />
    </aside>
  </div>
</Base>
