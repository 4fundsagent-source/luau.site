---
import DeobfuscatorCard from '~/components/DeobfuscatorCard.astro';
import ExternalLinks from '~/components/ExternalLinks.astro';
import Facts from '~/components/Facts.astro';
import Icon from '~/components/Icon.astro';
import Monogram from '~/components/Monogram.astro';
import ScoreCard from '~/components/ScoreCard.astro';
import Section from '~/components/Section.astro';
import SourcesList from '~/components/SourcesList.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import VersionTable from '~/components/VersionTable.astro';
import ChallengeCard from '~/components/ChallengeCard.astro';
import Base from '~/layouts/Base.astro';
import { formatDate, formatDuration, parseDate } from '~/lib/dates';
import { formatVersion, getSiteData, versionPhrase, type ObfuscatorView } from '~/lib/data';
import { issueUrl } from '~/lib/site';
import { PROVING_DAYS } from '~/lib/score';
import {
  SEGMENT_META,
  AVAILABILITY_LABEL,
  CODEBASE_CRITERIA,
  CODEBASE_MAX,
  CODEBASE_META,
  DISCLOSURE_LABEL,
  PRICING_LABEL,
  RUNTIME_LABEL,
  STATUS_META,
  TECHNIQUE_META,
} from '~/lib/taxonomy';

export async function getStaticPaths() {
  const { obfuscators } = await getSiteData();
  return obfuscators.map((o) => ({ params: { slug: o.id }, props: { o } }));
}

interface Props {
  o: ObfuscatorView;
}
const { o } = Astro.props;
const { deob, samples, obfuscators, builtAt } = await getSiteData();
const d = o.data;
const s = o.latest.s;
// Ranks are within a segment: commercial obfuscators are ranked against each other.
const rated = obfuscators.filter((x) => !x.score.unrated && x.segment === o.segment);
const rank = rated.indexOf(o) + 1;

const phrase = versionPhrase(o.latest.version);
// "v2.7.2 is broken" keeps its lowercase v; "the current version" gets a capital.
const Phrase = /^v\d/.test(phrase) ? phrase : phrase[0]!.toUpperCase() + phrase.slice(1);
const breaker = s.decisive[0] ? deob.get(s.decisive[0].deobfuscator) : undefined;
const headline =
  s.status === 'broken'
    ? `${Phrase} is broken${s.daysToBreak !== undefined ? `, ${formatDuration(s.daysToBreak, s.fuzzy)} after release` : ''}.`
    : s.status === 'partial'
      ? `${Phrase} is partially broken.`
      : o.openSource
        ? `${d.name} is open source, so it can never truly hold.`
        : `No public deobfuscator is tracked for ${phrase}.`;
const explainer =
  s.status === 'broken'
    ? `${breaker?.data.name ?? 'A public tool'} recovers readable source from it.`
    : s.status === 'partial'
      ? STATUS_META.partial.description
      : o.openSource
        ? 'Anyone can study exactly how it transforms code. It is scored on the strength of its codebase instead.'
        : o.latest.provingDay !== undefined
          ? s.released
            ? `It was released ${o.latest.provingDay} day${o.latest.provingDay === 1 ? '' : 's'} ago and is in its ${PROVING_DAYS}-day proving period.`
            : `luau.site has watched it for ${o.latest.provingDay} day${o.latest.provingDay === 1 ? '' : 's'}${d.challenges.some((c) => c.status === 'open') ? ', including an open public challenge' : ''}; it earns credit for each day it stays unbroken.`
          : "That means none we know of, not that it's unbreakable.";

const tools = o.deobfuscators.map((id) => deob.get(id)!);
const parent = o.basedOn ? obfuscators.find((x) => x.id === o.basedOn) : undefined;
const derivatives = o.derivatives.map((id) => obfuscators.find((x) => x.id === id)!);
const runs = samples.flatMap((sm) => sm.runs.filter((r) => r.obfuscator === o.id).map((r) => ({ sample: sm, run: r })));
---

<Base title={d.name} image={`/og/obfuscators/${o.id}.png`} description={`${d.name}: ${d.tagline} ${headline}`}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0" style="background:var(--glow)" aria-hidden="true"></div>
    <div class="container-page relative py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-subtle" data-enter style="--i:0">
        <a href="/obfuscators" class="hover:text-fg">Obfuscators</a>
        <span aria-hidden="true"> / </span>
        <span class="text-muted">{d.name}</span>
      </nav>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <Monogram name={d.name} id={o.id} size="lg" transitionName={`mono-${o.id}`} />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1 class="text-3xl font-semibold tracking-tight text-fg md:text-4xl" style={`view-transition-name:title-${o.id}`}>{d.name}</h1>
            <StatusBadge status={o.status} size="md" />
          </div>
          <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-muted" data-enter style="--i:2">{d.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-1.5" data-enter style="--i:3">
            <span class="chip num">{formatVersion(o.latest.version)}</span>
            <span class="chip">{PRICING_LABEL[d.pricing]}</span>
            {d.targets.length ? d.targets.map((t) => <span class="chip">{RUNTIME_LABEL[t]}</span>) : <span class="chip">Runtime unknown</span>}
            {d.discontinued && <span class="chip">Discontinued</span>}
            {o.segment === 'legacy' && <span class="chip">{SEGMENT_META.legacy.label}</span>}
            {d.availability !== 'public' && <span class="chip">{AVAILABILITY_LABEL[d.availability]}</span>}
            {d.beta && <span class="chip">Beta</span>}
          </div>
          <div class="mt-6" data-enter style="--i:4">
            <ExternalLinks variant="buttons" name={d.name} website={d.website} repo={d.repo} docs={d.docs} discord={d.discord} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-12">
      <div class="surface flex items-start gap-3 p-4 text-sm" style={`border-color:color-mix(in oklab, var(--${o.status}) 30%, var(--line))`}>
        <Icon name={o.status === 'holding' ? 'shield' : o.status === 'open' ? 'code' : 'unlock'} size={18} class="mt-0.5 shrink-0 text-muted" />
        <div>
          <p class="font-medium text-fg">{headline}</p>
          <p class="mt-1 text-muted">{explainer}</p>
        </div>
      </div>

      <Section id="versions" title="Version history" description="Status is derived from the deobfuscators below; nobody types it by hand.">
        <VersionTable versions={o.versions} deob={deob} openSource={o.openSource} />
        <a slot="action" href={issueUrl('version-release', { title: `New version: ${d.name}` })} class="text-sm text-muted hover:text-fg">
          Report a new version →
        </a>
      </Section>

      {
        d.challenges.length > 0 && (
          <Section
            id="challenges"
            title="Public challenges"
            description="Crackmes and bounties built with this obfuscator. An open challenge starts the clock on earning credit; a solved one needs a matching tool or writeup before it counts as a break."
          >
            <div class="grid grid-cols-1 gap-4">
              {d.challenges.map((c) => (
                <ChallengeCard c={c} now={builtAt} />
              ))}
            </div>
          </Section>
        )
      }

      <Section id="deobfuscators" title="Deobfuscators" description={`Tools that target any version of ${d.name}.`}>
        {
          tools.length ? (
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {tools.map((t, i) => (
                <DeobfuscatorCard d={t} index={i} />
              ))}
            </div>
          ) : (
            <div class="surface p-6 text-sm text-muted">
              No public deobfuscator is tracked for {d.name}.{' '}
              <a href={issueUrl('new-deobfuscator')} class="link">
                Know one?
              </a>
            </div>
          )
        }
      </Section>

      {
        o.openSource && d.codebase && (
          <Section
            id="codebase"
            title="Codebase grade"
            description={`Open-source projects are graded on their code: ${o.codebase}/${CODEBASE_MAX}, assessed ${formatDate(parseDate(d.codebase.assessedOn))}.`}
          >
            <ul class="surface divide-y divide-line">
              {CODEBASE_CRITERIA.map((c) => (
                <li class="flex flex-col gap-2 px-4 py-3 text-sm sm:flex-row sm:items-center sm:gap-4">
                  <span class="shrink-0 font-medium text-fg sm:w-44">{CODEBASE_META[c].label}</span>
                  <span class="flex-1 text-muted">{CODEBASE_META[c].description}</span>
                  <span class="flex shrink-0 items-center gap-1" role="img" aria-label={`${d.codebase![c]} of 4`}>
                    {[0, 1, 2, 3].map((i) => (
                      <span class:list={['h-1.5 w-5 rounded-full', i < d.codebase![c] ? 'bg-fg' : 'bg-sunken']} />
                    ))}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm text-muted">{d.codebase.notes}</p>
          </Section>
        )
      }

      <Section id="techniques" title="Protection techniques" description="As documented by the vendor or observed in output.">
        {
          d.techniques.length ? (
            <ul class="surface divide-y divide-line">
              {d.techniques.map((t) => (
                <li class="flex flex-col gap-1 px-4 py-3 text-sm sm:flex-row sm:gap-4">
                  <a href={`/learn#${t}`} class="shrink-0 font-medium text-fg hover:underline sm:w-44">
                    {TECHNIQUE_META[t].label}
                  </a>
                  <span class="text-muted">{TECHNIQUE_META[t].description}</span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="surface p-6 text-sm text-muted">
              Not documented yet.{' '}
              <a href={issueUrl('correction', { title: `Techniques: ${d.name}` })} class="link">
                Know what it uses?
              </a>
            </div>
          )
        }
      </Section>

      <Section id="lab" title="In the Lab" description="Our own benchmark scripts, run through this obfuscator and every deobfuscator.">
        {
          runs.length ? (
            <ul class="surface divide-y divide-line text-sm">
              {runs.map(({ sample, run }) => (
                <li>
                  <a href={`/lab/${sample.id}/${run.id}`} class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-hover">
                    <span class="text-fg">{sample.meta.title}</span>
                    <span class="num text-muted">
                      {formatVersion(run.version)} · {run.deob.length} deobfuscation{run.deob.length === 1 ? '' : 's'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="surface flex items-start gap-3 p-6 text-sm text-muted">
              <Icon name="flask" size={18} class="shrink-0" />
              <p>
                {o.openSource
                  ? 'Not benchmarked yet. Open source gets no credit for missing Lab results.'
                  : 'Not benchmarked yet, so the Lab component of the score gets neutral half credit.'}{' '}
                <a href="/lab#contribute" class="link">
                  How to add a run
                </a>
              </p>
            </div>
          )
        }
      </Section>

      <Section id="about" title="About">
        <p class="max-w-prose leading-relaxed text-muted">{d.description}</p>
        {
          (parent || derivatives.length > 0) && (
            <div class="mt-5 flex flex-wrap items-center gap-2 text-sm">
              <Icon name="layers" size={15} class="text-subtle" />
              {parent && (
                <span class="text-muted">
                  Based on{' '}
                  <a href={`/obfuscators/${parent.id}`} class="link text-fg">
                    {parent.data.name}
                  </a>
                  {derivatives.length > 0 && '. '}
                </span>
              )}
              {derivatives.length > 0 && (
                <span class="text-muted">
                  Tracked forks and services built on it:{' '}
                  {derivatives.map((x, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/obfuscators/${x.id}`} class="link text-fg">
                        {x.data.name}
                      </a>
                    </>
                  ))}
                </span>
              )}
              <span class="w-full text-xs text-subtle">Lineage is informational and does not change scores.</span>
            </div>
          )
        }
      </Section>

      <Section id="sources" title="Sources & verification">
        <SourcesList
          sources={d.sources}
          verified={d.verified}
          lastVerified={d.lastVerified}
          stale={o.stale}
          file={`src/data/obfuscators/${o.id}.yaml`}
          name={d.name}
        />
      </Section>
    </div>

    <aside class="order-first space-y-4 lg:sticky lg:top-20 lg:order-none lg:self-start">
      <ScoreCard score={o.score} />
      <Facts
        items={[
          {
            label: 'Rank',
            value: rank ? `#${rank} of ${rated.length} ${o.segment === 'current' ? 'commercial' : 'open source & legacy'}` : 'Unrated',
            href: '/rankings',
          },
          { label: 'Vendor', value: d.vendor },
          { label: 'Based on', value: parent?.data.name, href: parent && `/obfuscators/${parent.id}` },
          { label: 'Since', value: d.since },
          { label: 'Pricing', value: PRICING_LABEL[d.pricing] },
          { label: 'License', value: d.license },
          { label: 'Availability', value: d.availability !== 'public' ? `${AVAILABILITY_LABEL[d.availability]}${d.beta ? ' (beta)' : ''}` : d.beta ? 'Beta' : undefined },
          { label: 'Changelog', value: d.disclosure ? DISCLOSURE_LABEL[d.disclosure] : undefined },
          { label: 'Watched since', value: o.observedSince && !s.released ? formatDate(o.observedSince) : undefined },
          { label: 'Versions tracked', value: o.versions.length },
          { label: 'Latest release', value: s.released ? formatDate(s.released) : undefined },
          { label: 'Broken on', value: s.brokenOn ? formatDate(s.brokenOn) : undefined },
        ]}
      />
    </aside>
  </div>
</Base>
