---
import ArmsRaceChart from '~/components/ArmsRaceChart.astro';
import EventList from '~/components/EventList.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import Base from '~/layouts/Base.astro';
import { formatDate, formatDuration } from '~/lib/dates';
import { formatVersion, getSiteData } from '~/lib/data';
import { median as medianOf } from '~/lib/status';

const data = await getSiteData();
const { stats, events, obf, builtAt } = data;
const DAY = 86_400_000;
const since90 = builtAt.getTime() - 90 * DAY;

// The timeline follows the commercial, maintained obfuscators; the log can reveal the rest.
const featured = data.obfuscators.filter((o) => o.segment === 'current');
const featuredIds = featured.map((o) => o.id);
const standing = data.standing.filter((s) => featuredIds.includes(s.obfuscator));
const featuredEvents = events.filter((e) => e.segment === 'current');

const recentBreaks = featuredEvents.filter((e) => e.kind === 'break' && e.date.date.getTime() >= since90).length;
const recentTools = data.deobfuscators.filter(
  (d) => d.group === 'current' && d.firstSeen && d.firstSeen.date.getTime() >= since90,
).length;
const ttb = featured.flatMap((o) => o.versions.filter((v) => v.s.daysToBreak !== undefined).map((v) => v.s));
const median = medianOf(ttb.map((v) => v.daysToBreak!));
const medianFuzzy = ttb.some((v) => v.fuzzy);

// Unbroken latest versions, longest-standing first (an open public challenge counts from its posting date).
const named = (name: string, version: string) => (/^\d/.test(version) ? `${name} ${formatVersion(version)}` : name);
const reasonText = (s: (typeof standing)[number]) =>
  s.reason === 'challenge'
    ? `${s.challenge?.platform ?? 'public'} challenge since ${formatDate(s.since)}${s.challenge?.bounty ? ` · ${s.challenge.bounty} bounty` : ''}`
    : s.reason === 'release'
      ? `released ${formatDate(s.since)}`
      : `watched since ${formatDate(s.since)}`;
---

<Base title="Timeline" description="The arms race between Lua obfuscators and deobfuscators: every release, every public break, and the tools behind them.">
  <PageHeader
    eyebrow="Analysis"
    title="The Arms Race"
    description="Every release, every public break, and when the tools that broke them appeared. Releases and breaks are derived from the data, so this page updates itself."
  />

  <div class="container-page space-y-14 py-10">
    <!-- Unbroken right now -->
    {
      standing.length > 0 && (
        <section aria-labelledby="unbroken-title" data-enter style="--i:4">
          <div class="mb-3 flex items-end justify-between gap-4">
            <h2 id="unbroken-title" class="eyebrow">
              Unbroken right now
            </h2>
            <a href="/rankings" class="text-sm text-muted hover:text-fg">
              See rankings →
            </a>
          </div>
          <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
            {standing.map((s, i) => {
              const o = obf.get(s.obfuscator)!;
              return (
                <li class="bg-elev">
                  <a href={s.reason === 'challenge' ? `/obfuscators/${o.id}#challenges` : `/obfuscators/${o.id}`} class="group flex h-full items-start gap-3 px-5 py-4 hover:bg-hover">
                    <span class="num pt-0.5 text-xs text-subtle">#{i + 1}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-medium text-fg group-hover:underline">{named(o.data.name, s.version)}</span>
                      <span class="mt-0.5 block text-xs text-subtle">{reasonText(s)}</span>
                    </span>
                    <span class="num shrink-0 text-right text-xs text-muted">
                      <span class="text-xl font-semibold tracking-tight text-fg">{s.days}</span> d
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    <!-- Headline numbers -->
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4" data-reveal>
      {
        [
          { label: 'Breaks, last 90 days', value: recentBreaks },
          { label: 'New tools, last 90 days', value: recentTools },
          { label: 'Obfuscators tracked', value: stats.obfuscators },
          {
            label: 'Median time to break',
            text: median !== undefined ? formatDuration(median, medianFuzzy) : '—',
          },
        ].map((s) => (
          <div class="bg-elev px-5 py-4">
            <dt class="text-xs text-subtle">{s.label}</dt>
            <dd class="num mt-1 text-2xl font-semibold tracking-tight text-fg">
              {'value' in s ? <span data-countup={s.value}>{s.value}</span> : s.text}
            </dd>
          </div>
        ))
      }
    </dl>

    <Section
      title="The last few months"
      description="Commercial and maintained obfuscators only, still-standing lanes first. Open-source and legacy events are in the log below. Hover or focus any mark for details."
    >
      <div class="surface p-4 sm:p-6">
        <ArmsRaceChart data={data} only={featuredIds} />
      </div>
    </Section>

    <Section id="log" title="Event log" description="Every release, break, new tool and challenge, newest first. Releases and breaks are derived from the data; other events are added by hand with a source.">
      <a slot="action" href="/feed.xml" class="text-sm text-muted hover:text-fg">RSS feed →</a>
      <EventList events={events} grouped filterable segmentToggle />
    </Section>
  </div>
</Base>
