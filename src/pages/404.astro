---
import Base from '~/layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="container-page py-28 text-center">
    <p class="num text-sm text-subtle">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">This page is still obfuscated.</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">We couldn't find what you were looking for. It may have been renamed when the data changed.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Go home</a>
      <button type="button" data-search-open class="btn">Search the site</button>
    </div>
  </section>
</Base>
