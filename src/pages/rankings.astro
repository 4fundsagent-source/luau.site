---
import Monogram from '~/components/Monogram.astro';
import PageHeader from '~/components/PageHeader.astro';
import ScoreBar from '~/components/ScoreBar.astro';
import Section from '~/components/Section.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import Base from '~/layouts/Base.astro';
import { formatDate, formatDuration } from '~/lib/dates';
import { formatVersion, getSiteData } from '~/lib/data';
import { settledSurvivals, TIERS } from '~/lib/score';
import { median } from '~/lib/status';

const { obfuscators, deob, builtAt } = await getSiteData();

const rows = obfuscators.filter((o) => !o.score.unrated).map((o, i) => {
  // Open source can't hold, so survival is not meaningful for it.
  const { days, fuzzy } = o.openSource ? { days: [], fuzzy: false } : settledSurvivals(o.versions.map((v) => v.s), builtAt);
  return { o, rank: i + 1, med: median(days), fuzzy };
});

const unrated = obfuscators.filter((o) => o.score.unrated);

const fastest = obfuscators
  .flatMap((o) => o.versions.filter((v) => v.s.daysToBreak !== undefined).map((v) => ({ o, v })))
  .sort((a, b) => a.v.s.daysToBreak! - b.v.s.daysToBreak!);
---

<Base title="Rankings" description="Lua and Luau obfuscators ranked by Security Score: resistance to public deobfuscation, track record, Lab results and technique depth.">
  <PageHeader
    eyebrow="Analysis"
    title="Rankings"
    description="Every obfuscator ranked by Security Score. Scores are computed from sourced data, and a dashed tier means the score is provisional because too little data backs it."
  >
    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      {
        TIERS.map((t, i) => (
          <span class="chip">
            <span class="num font-semibold text-fg">{t.tier}</span>
            {i === 0 ? `≥ ${t.min}` : t.min === 0 ? `< ${TIERS[i - 1]!.min}` : `${t.min}–${TIERS[i - 1]!.min - 1}`}
          </span>
        ))
      }
      <a href="/methodology#score" class="chip hover:text-fg">How scores work →</a>
    </div>
  </PageHeader>

  <div class="container-page space-y-14 py-10">
    <Section title="Leaderboard" description="Ranked by Security Score.">
      <ol class="surface divide-y divide-line md:hidden">
        {
          rows.map(({ o, rank, med, fuzzy }, i) => (
            <li class="relative px-4 py-3.5" data-reveal style={`--reveal-i:${i}`}>
              <div class="flex items-center gap-3">
                <span class="num w-4 text-sm text-subtle">{rank}</span>
                <Monogram name={o.data.name} id={o.id} size="sm" />
                <div class="min-w-0 flex-1">
                  <a href={`/obfuscators/${o.id}`} class="card-link block truncate text-sm font-medium text-fg">
                    {o.data.name}
                  </a>
                  <span class="num text-xs text-subtle">
                    {formatVersion(o.latest.version)} · {med !== undefined ? `held ${formatDuration(med, fuzzy)}` : 'no dated versions'}
                  </span>
                </div>
                <StatusBadge status={o.status} />
              </div>
              <ScoreBar class="mt-3 pl-7" score={o.score.total} tier={o.score.tier} confidence={o.score.confidence} provisional={o.score.provisional} />
            </li>
          ))
        }
      </ol>
      <div class="surface hidden overflow-x-auto md:block">
        <table class="w-full min-w-[46rem] text-left text-sm" data-sortable>
          <thead class="border-b border-line bg-sunken text-xs text-subtle">
            <tr>
              <th scope="col" class="w-12 px-4 py-2.5 font-medium"><button type="button" data-key="rank" data-type="number">#</button></th>
              <th scope="col" class="px-4 py-2.5 font-medium"><button type="button" data-key="name" data-type="string">Obfuscator</button></th>
              <th scope="col" class="w-64 px-4 py-2.5 font-medium"><button type="button" data-key="score" data-type="number">Score</button></th>
              <th scope="col" class="px-4 py-2.5 font-medium"><button type="button" data-key="status" data-type="number">Status</button></th>
              <th scope="col" class="px-4 py-2.5 font-medium whitespace-nowrap"><button type="button" data-key="survival" data-type="number">Median survival</button></th>
              <th scope="col" class="px-4 py-2.5 text-right font-medium"><button type="button" data-key="confidence" data-type="number">Data</button></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              rows.map(({ o, rank, med, fuzzy }, i) => (
                <tr
                  data-reveal
                  style={`--reveal-i:${i}`}
                  class="transition-colors hover:bg-hover"
                  data-rank={rank}
                  data-name={o.data.name.toLowerCase()}
                  data-score={o.score.total}
                  data-status={{ holding: 4, open: 3, partial: 2, broken: 1 }[o.status]}
                  data-survival={med ?? -1}
                  data-confidence={o.score.confidence}
                >
                  <td class="num px-4 py-3 text-muted">{rank}</td>
                  <td class="px-4 py-3">
                    <a href={`/obfuscators/${o.id}`} class="flex items-center gap-3">
                      <Monogram name={o.data.name} id={o.id} size="sm" />
                      <span>
                        <span class="block font-medium text-fg hover:underline">{o.data.name}</span>
                        <span class="num block text-xs text-subtle">{formatVersion(o.latest.version)}</span>
                      </span>
                    </a>
                  </td>
                  <td class="px-4 py-3">
                    <ScoreBar score={o.score.total} tier={o.score.tier} confidence={o.score.confidence} provisional={o.score.provisional} />
                  </td>
                  <td class="px-4 py-3">
                    <StatusBadge status={o.status} />
                  </td>
                  <td class="num px-4 py-3 whitespace-nowrap text-muted">{med !== undefined ? formatDuration(med, fuzzy) : '—'}</td>
                  <td class="num px-4 py-3 text-right whitespace-nowrap text-muted">
                    {Math.round(o.score.confidence * 100)}%{o.score.provisional && <span class="text-subtle"> · prov.</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Section>

 {
      unrated.length > 0 && (
        <Section
          title="Not enough data to rank"
          description="Less than 55% of these scores would rest on real data, so they get no rank or tier yet. Help fill them in."
        >
          <ul class="surface divide-y divide-line">
            {unrated.map((o) => (
              <li class="relative flex items-center gap-3 px-4 py-3.5 transition-colors hover:bg-hover">
                <Monogram name={o.data.name} id={o.id} size="sm" />
                <div class="min-w-0 flex-1">
                  <a href={`/obfuscators/${o.id}`} class="card-link block truncate text-sm font-medium text-fg">
                    {o.data.name}
                  </a>
                  <span class="text-xs text-subtle">{Math.round(o.score.confidence * 100)}% backed by data</span>
                </div>
                <StatusBadge status={o.status} />
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section title="Fastest broken" description="Versions with known release and break dates, ordered by how long they held.">
      {
        fastest.length ? (
          <div class="surface overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left text-sm">
              <thead class="border-b border-line bg-sunken text-xs text-subtle">
                <tr>
                  <th scope="col" class="px-4 py-2.5 font-medium">Version</th>
                  <th scope="col" class="px-4 py-2.5 font-medium">Released</th>
                  <th scope="col" class="px-4 py-2.5 font-medium">Broken</th>
                  <th scope="col" class="px-4 py-2.5 font-medium">Held for</th>
                  <th scope="col" class="px-4 py-2.5 font-medium">First readable-source tool</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {fastest.map(({ o, v }) => {
                  const tool = deob.get(v.s.decisive[0]!.deobfuscator)!;
                  return (
                    <tr>
                      <td class="px-4 py-3">
                        <a href={`/obfuscators/${o.id}#v-${v.version.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`} class="link">
                          {o.data.name} {formatVersion(v.version)}
                        </a>
                      </td>
                      <td class="px-4 py-3 whitespace-nowrap text-muted">{formatDate(v.s.released)}</td>
                      <td class="px-4 py-3 whitespace-nowrap text-muted">{formatDate(v.s.brokenOn)}</td>
                      <td class="num px-4 py-3 whitespace-nowrap font-medium text-fg">{formatDuration(v.s.daysToBreak!, v.s.fuzzy)}</td>
                      <td class="px-4 py-3">
                        <a href={`/deobfuscators/${tool.id}`} class="link">
                          {tool.data.name}
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="surface p-6 text-sm text-muted">No version has both a release and a break date yet.</div>
        )
      }
    </Section>
  </div>
</Base>

<style>
  th button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  th button:hover {
    color: var(--fg);
  }
  th[aria-sort] button {
    color: var(--fg);
  }
  th[aria-sort='ascending'] button::after {
    content: ' ↑';
  }
  th[aria-sort='descending'] button::after {
    content: ' ↓';
  }
</style>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('table[data-sortable]')) {
    const tbody = table.tBodies[0]!;
    let current = { key: 'rank', dir: 1 };
    table.querySelectorAll<HTMLButtonElement>('th button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key!;
        const numeric = btn.dataset.type === 'number';
        const dir = current.key === key ? -current.dir : numeric && key !== 'rank' ? -1 : 1;
        current = { key, dir };
        const rows = [...tbody.rows].sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          return (numeric ? Number(av) - Number(bv) : av.localeCompare(bv)) * dir;
        });
        tbody.append(...rows);
        table.querySelectorAll('th').forEach((th) => th.removeAttribute('aria-sort'));
        btn.closest('th')!.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
      });
    });
  }
</script>
