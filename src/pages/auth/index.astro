---
import AuthCard from '~/components/AuthCard.astro';
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import Base from '~/layouts/Base.astro';
import { getSiteData } from '~/lib/data';
import { issueUrl } from '~/lib/site';

const { auth } = await getSiteData();
---

<Base title="Auth services" description="Key systems, whitelists and licensing services for Lua scripts, and whether they've been publicly bypassed.">
  <PageHeader
    eyebrow="Directory"
    title="Auth services"
    description="Key systems, whitelists and loaders that decide who can run a script, often bundled with obfuscation. We track their features and whether a public bypass exists."
  />
  <div class="container-page py-10">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {auth.map((a, i) => <AuthCard a={a} index={i} />)}
    </div>
    <p class="mt-8 flex items-center gap-2 text-sm text-muted">
      <Icon name="plus" size={15} />
      Missing a service?
      <a href={issueUrl('new-auth-service')} class="link">Submit it with a source</a>
    </p>
  </div>
</Base>
