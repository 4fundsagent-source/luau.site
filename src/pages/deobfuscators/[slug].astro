---
import ExternalLinks from '~/components/ExternalLinks.astro';
import Facts from '~/components/Facts.astro';
import Monogram from '~/components/Monogram.astro';
import Section from '~/components/Section.astro';
import SourcesList from '~/components/SourcesList.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import Base from '~/layouts/Base.astro';
import { formatDate } from '~/lib/dates';
import { githubStats } from '~/lib/github';
import { formatVersion, getSiteData, listRuntimes, type DeobfuscatorView } from '~/lib/data';
import { DEOB_WEIGHTS } from '~/lib/deobScore';
import { ACCESS_LABEL, DEOB_KIND_LABEL, DEOB_TECHNIQUE_META, MAINTENANCE_LABEL, OUTPUT_META, RUNTIME_LABEL } from '~/lib/taxonomy';

export async function getStaticPaths() {
  const { deobfuscators } = await getSiteData();
  return deobfuscators.map((d) => ({ params: { slug: d.id }, props: { d } }));
}

interface Props {
  d: DeobfuscatorView;
}
const { d } = Astro.props;
const { samples, deobfuscators, obf } = await getSiteData();
const x = d.data;
const gh = githubStats(x.repo);
const rank = deobfuscators.indexOf(d) + 1;
const best = d.score.best ? obf.get(d.score.best.obfuscator) : undefined;
const impactDetail =
  x.kind === 'decompiler'
    ? 'A decompiler breaks no obfuscator on its own, so it gets a fixed, low relevance.'
    : x.kind === 'env-logger'
      ? 'An env logger records what a script does rather than recovering its source, so it gets a fixed, low relevance.'
      : best && d.score.best
      ? `Strongest target: ${best.data.name} ${formatVersion(d.score.best.version)}${d.score.best.latest ? ' (current version)' : ''}, a ${best.segment === 'current' ? 'commercial, maintained' : 'open-source or legacy'} obfuscator.`
      : 'No coverage counts toward impact.';
const runs = samples.flatMap((s) =>
  s.runs.flatMap((r) => r.deob.filter((dr) => dr.deobfuscator === d.id).map((dr) => ({ sample: s, run: r, dr }))),
);
---

<Base title={x.name} image={`/og/deobfuscators/${d.id}.png`} description={`${x.name} by ${x.author}: ${x.tagline}`}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0" style="background:var(--glow)" aria-hidden="true"></div>
    <div class="container-page relative py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-subtle" data-enter style="--i:0">
        <a href="/deobfuscators" class="hover:text-fg">Deobfuscators</a>
        <span aria-hidden="true"> / </span>
        <span class="text-muted">{x.name}</span>
      </nav>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <Monogram name={x.name} id={d.id} size="lg" transitionName={`mono-${d.id}`} />
        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-semibold tracking-tight break-words text-fg md:text-4xl" style={`view-transition-name:title-${d.id}`}>{x.name}</h1>
          <p class="mt-1 text-sm text-muted">by {x.author}</p>
          <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-muted" data-enter style="--i:2">{x.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-1.5" data-enter style="--i:3">
            {x.kind !== 'deobfuscator' && <span class="chip">{DEOB_KIND_LABEL[x.kind]}</span>}
            <span class="chip">{ACCESS_LABEL[x.access]}</span>
            {x.license && <span class="chip">{x.license}</span>}
            <span class="chip">{OUTPUT_META[x.outputLevel].label}</span>
            <span class="chip">{MAINTENANCE_LABEL[x.maintenance]}</span>
          </div>
          <div class="mt-6" data-enter style="--i:4">
            <ExternalLinks variant="buttons" name={x.name} website={x.website} repo={x.repo} docs={x.docs} discord={x.discord} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-12">
      {
        x.kind === 'decompiler' && (
          <Section
            id="decompiles"
            title="What it decompiles"
            description="Decompilers read standard bytecode, not obfuscated scripts, so they never break an obfuscator by themselves."
          >
            <ul class="surface divide-y divide-line text-sm">
              {x.decompiles.map((r) => (
                <li class="flex items-center justify-between gap-4 px-4 py-3">
                  <span class="text-fg">{RUNTIME_LABEL[r]} bytecode</span>
                  <span class="text-muted">{OUTPUT_META[x.outputLevel].label}</span>
                </li>
              ))}
            </ul>
          </Section>
        )
      }

      {
        x.kind === 'env-logger' && (
          <Section
            id="logs"
            title="What it logs"
            description="Env loggers run a protected script in a hooked environment instead of reading it, so they work against any obfuscator that does not detect the hooks."
          >
            <div class="surface p-4 text-sm text-muted">
              The output is a record of what the script does at runtime — services, remotes, URLs and constants it touches — not
              its source. That rates as <span class="text-fg">{OUTPUT_META[x.outputLevel].label.toLowerCase()}</span> output here, so an env
              logger never breaks an obfuscator version on its own.
            </div>
            {x.bypasses.length > 0 && (
              <ul class="surface mt-4 divide-y divide-line text-sm" aria-label="Claimed anti-tamper bypasses">
                {x.bypasses.map((b) => (
                  <li class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                    <a href={`/obfuscators/${b.obfuscator.id}`} class="link w-fit">
                      {obf.get(b.obfuscator.id)?.data.name ?? b.obfuscator.id}
                    </a>
                    <span class="text-muted">{b.note ?? 'Claims to get past its anti-tamper; not verified by luau.site.'}</span>
                  </li>
                ))}
              </ul>
            )}
          </Section>
        )
      }

      {
        d.coverage.length > 0 && (
          <Section
            id="coverage"
            title="Coverage"
            description="Which obfuscator versions this tool targets. Only full support with readable output counts as a break."
          >
            <ul class="surface divide-y divide-line text-sm">
              {
                d.coverage.map((c) => (
                  <li class="grid grid-cols-[1fr_auto] items-start gap-x-4 gap-y-1 px-4 py-3 sm:grid-cols-[10rem_6rem_1fr_auto]">
                    <a href={`/obfuscators/${c.obfuscator}`} class="link w-fit">
                      {c.obfuscatorName}
                    </a>
                    <span class="num text-fg sm:order-none">
                      {formatVersion(c.version)}
                      {c.isLatest && (
                        <span class="ml-2 rounded bg-accent-soft px-1.5 py-px font-sans text-[0.6875rem] font-medium text-accent">latest</span>
                      )}
                    </span>
                    <span class="text-muted">
                      <span class="capitalize">{c.support}</span> support
                      {c.notes && <span class="block text-xs text-subtle">{c.notes}</span>}
                    </span>
                    <span class="justify-self-end">
                      <StatusBadge status={c.effect === 'break' ? 'broken' : 'partial'} label={c.effect === 'break' ? 'Breaks' : 'Partial'} />
                    </span>
                  </li>
                ))
              }
            </ul>
          </Section>
        )
      }

      <Section id="how" title="How it works">
        <p class="max-w-prose leading-relaxed text-muted">{x.description}</p>
        <ul class="surface mt-5 divide-y divide-line">
          {
            x.techniques.map((t) => (
              <li class="flex flex-col gap-1 px-4 py-3 text-sm sm:flex-row sm:gap-4">
                <a href={`/learn#${t}`} class="shrink-0 font-medium text-fg hover:underline sm:w-44">
                  {DEOB_TECHNIQUE_META[t].label}
                </a>
                <span class="text-muted">{DEOB_TECHNIQUE_META[t].description}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="lab" title="In the Lab">
        {
          runs.length ? (
            <ul class="surface divide-y divide-line text-sm">
              {runs.map(({ sample, run, dr }) => (
                <li>
                  <a href={`/lab/${sample.id}/${run.id}`} class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-hover">
                    <span class="text-fg">
                      {sample.meta.title} <span class="text-muted">· {run.obfuscator} {formatVersion(run.version)}</span>
                    </span>
                    <span class="text-muted">{dr.result ? (dr.result.ok ? 'Behavior matches' : 'Mismatch') : 'Not verified'}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="surface p-6 text-sm text-muted">
              No Lab runs yet for this tool. <a href="/lab#contribute" class="link">How to add one</a>
            </div>
          )
        }
      </Section>

      <Section id="sources" title="Sources & verification">
        <SourcesList
          sources={x.sources}
          verified={x.verified}
          lastVerified={x.lastVerified}
          stale={d.stale}
          file={`src/data/deobfuscators/${d.id}.yaml`}
          name={x.name}
        />
      </Section>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start">
      <div class="surface p-5" data-reveal>
        <div class="flex items-center justify-between">
          <p class="eyebrow">Deobfuscator Score</p>
          <a href="/methodology#deobfuscator-score" class="text-xs text-subtle hover:text-fg">How it works</a>
        </div>
        <div class="mt-3 flex items-end gap-3">
          <span class="text-5xl leading-none font-semibold tracking-tight text-fg" data-countup={d.score.total}>{d.score.total}</span>
          <span class="pb-1 text-sm text-subtle">/ 100</span>
          <span class="num ml-auto grid size-10 place-items-center rounded-lg border border-line text-lg font-semibold" aria-label={`Tier ${d.score.tier}`}>
            {d.score.tier}
          </span>
        </div>
        <ul class="mt-5 space-y-4">
          {
            [
              { label: 'Impact', points: d.score.impact, weight: DEOB_WEIGHTS.impact, detail: impactDetail },
              {
                label: 'Craft',
                points: d.score.craft,
                weight: DEOB_WEIGHTS.craft,
                detail: `${OUTPUT_META[x.outputLevel].label}, ${MAINTENANCE_LABEL[x.maintenance].toLowerCase()}, ${ACCESS_LABEL[x.access].toLowerCase()}; scaled by how relevant its targets are.`,
              },
            ].map((c) => (
              <li>
                <div class="flex items-baseline justify-between text-sm">
                  <span class="text-fg">{c.label}</span>
                  <span class="num text-xs text-muted">
                    {c.points}
                    <span class="text-subtle">/{c.weight}</span>
                  </span>
                </div>
                <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-sunken">
                  <div class="score-fill h-full rounded-full" style={`width:${(c.points / c.weight) * 100}%;background:var(--fg)`} />
                </div>
                <p class="mt-1.5 text-xs leading-relaxed text-subtle">{c.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <Facts
        items={[
          { label: 'Rank', value: `#${rank} of ${deobfuscators.length}`, href: '/rankings#deobfuscators' },
          {
            label: 'Kind',
            value:
              x.kind === 'decompiler'
                ? `Decompiler (${listRuntimes(x.decompiles)})`
                : x.kind === 'env-logger'
                  ? DEOB_KIND_LABEL[x.kind]
                  : undefined,
          },
          { label: 'Author', value: x.author },
          { label: 'Access', value: ACCESS_LABEL[x.access] },
          { label: 'License', value: x.license },
          { label: 'Output', value: OUTPUT_META[x.outputLevel].label },
          { label: 'First seen', value: d.firstSeen ? formatDate(d.firstSeen) : 'Unknown' },
          { label: 'Maintenance', value: MAINTENANCE_LABEL[x.maintenance] },
          { label: 'Versions covered', value: x.kind === 'deobfuscator' ? d.coverage.length : d.coverage.length || undefined },
          { label: 'GitHub stars', value: gh?.stars.toLocaleString() },
          { label: 'Last push', value: gh?.pushedAt },
          { label: 'Repository', value: gh?.archived ? 'Archived' : undefined },
        ]}
      />
      <div class="surface p-4 text-xs leading-relaxed text-muted">
        luau.site links to deobfuscators so the state of protection is transparent. We don't host these tools or their output on
        other people's scripts.
      </div>
    </aside>
  </div>
</Base>
