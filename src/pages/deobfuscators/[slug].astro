---
import ExternalLinks from '~/components/ExternalLinks.astro';
import Facts from '~/components/Facts.astro';
import Monogram from '~/components/Monogram.astro';
import Section from '~/components/Section.astro';
import SourcesList from '~/components/SourcesList.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import Base from '~/layouts/Base.astro';
import { formatDate } from '~/lib/dates';
import { formatVersion, getSiteData, type DeobfuscatorView } from '~/lib/data';
import { ACCESS_LABEL, DEOB_TECHNIQUE_META, MAINTENANCE_LABEL, OUTPUT_META } from '~/lib/taxonomy';

export async function getStaticPaths() {
  const { deobfuscators } = await getSiteData();
  return deobfuscators.map((d) => ({ params: { slug: d.id }, props: { d } }));
}

interface Props {
  d: DeobfuscatorView;
}
const { d } = Astro.props;
const { samples } = await getSiteData();
const x = d.data;
const runs = samples.flatMap((s) =>
  s.runs.flatMap((r) => r.deob.filter((dr) => dr.deobfuscator === d.id).map((dr) => ({ sample: s, run: r, dr }))),
);
---

<Base title={x.name} image={`/og/deobfuscators/${d.id}.png`} description={`${x.name} by ${x.author}: ${x.tagline}`}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0" style="background:var(--glow)" aria-hidden="true"></div>
    <div class="container-page relative py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-subtle">
        <a href="/deobfuscators" class="hover:text-fg">Deobfuscators</a>
        <span aria-hidden="true"> / </span>
        <span class="text-muted">{x.name}</span>
      </nav>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <Monogram name={x.name} id={d.id} size="lg" transitionName={`mono-${d.id}`} />
        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-semibold tracking-tight break-words text-fg md:text-4xl">{x.name}</h1>
          <p class="mt-1 text-sm text-muted">by {x.author}</p>
          <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-muted">{x.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <span class="chip">{ACCESS_LABEL[x.access]}</span>
            {x.license && <span class="chip">{x.license}</span>}
            <span class="chip">{OUTPUT_META[x.outputLevel].label}</span>
            <span class="chip">{MAINTENANCE_LABEL[x.maintenance]}</span>
          </div>
          <div class="mt-6">
            <ExternalLinks variant="buttons" name={x.name} website={x.website} repo={x.repo} docs={x.docs} discord={x.discord} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-12">
      <Section
        id="coverage"
        title="Coverage"
        description="Which obfuscator versions this tool targets. Only full support with readable output counts as a break."
      >
        <ul class="surface divide-y divide-line text-sm">
          {
            d.coverage.map((c) => (
              <li class="grid grid-cols-[1fr_auto] items-start gap-x-4 gap-y-1 px-4 py-3 sm:grid-cols-[10rem_6rem_1fr_auto]">
                <a href={`/obfuscators/${c.obfuscator}`} class="link w-fit">
                  {c.obfuscatorName}
                </a>
                <span class="num text-fg sm:order-none">
                  {formatVersion(c.version)}
                  {c.isLatest && (
                    <span class="ml-2 rounded bg-accent-soft px-1.5 py-px font-sans text-[0.6875rem] font-medium text-accent">latest</span>
                  )}
                </span>
                <span class="text-muted">
                  <span class="capitalize">{c.support}</span> support
                  {c.notes && <span class="block text-xs text-subtle">{c.notes}</span>}
                </span>
                <span class="justify-self-end">
                  <StatusBadge status={c.effect === 'break' ? 'broken' : 'partial'} label={c.effect === 'break' ? 'Breaks' : 'Partial'} />
                </span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="how" title="How it works">
        <p class="max-w-prose leading-relaxed text-muted">{x.description}</p>
        <ul class="surface mt-5 divide-y divide-line">
          {
            x.techniques.map((t) => (
              <li class="flex flex-col gap-1 px-4 py-3 text-sm sm:flex-row sm:gap-4">
                <a href={`/learn#${t}`} class="shrink-0 font-medium text-fg hover:underline sm:w-44">
                  {DEOB_TECHNIQUE_META[t].label}
                </a>
                <span class="text-muted">{DEOB_TECHNIQUE_META[t].description}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="lab" title="In the Lab">
        {
          runs.length ? (
            <ul class="surface divide-y divide-line text-sm">
              {runs.map(({ sample, run, dr }) => (
                <li>
                  <a href={`/lab/${sample.id}/${run.id}`} class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-hover">
                    <span class="text-fg">
                      {sample.meta.title} <span class="text-muted">· {run.obfuscator} {formatVersion(run.version)}</span>
                    </span>
                    <span class="text-muted">{dr.result ? (dr.result.ok ? 'Behavior matches' : 'Mismatch') : 'Not verified'}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="surface p-6 text-sm text-muted">
              No Lab runs yet for this tool. <a href="/lab#contribute" class="link">How to add one</a>
            </div>
          )
        }
      </Section>

      <Section id="sources" title="Sources & verification">
        <SourcesList
          sources={x.sources}
          verified={x.verified}
          lastVerified={x.lastVerified}
          stale={d.stale}
          file={`src/data/deobfuscators/${d.id}.yaml`}
          name={x.name}
        />
      </Section>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start">
      <Facts
        items={[
          { label: 'Author', value: x.author },
          { label: 'Access', value: ACCESS_LABEL[x.access] },
          { label: 'License', value: x.license },
          { label: 'Output', value: OUTPUT_META[x.outputLevel].label },
          { label: 'First seen', value: d.firstSeen ? formatDate(d.firstSeen) : 'Unknown' },
          { label: 'Maintenance', value: MAINTENANCE_LABEL[x.maintenance] },
          { label: 'Versions covered', value: d.coverage.length },
        ]}
      />
      <div class="surface p-4 text-xs leading-relaxed text-muted">
        luau.site links to deobfuscators so the state of protection is transparent. We don't host these tools or their output on
        other people's scripts.
      </div>
    </aside>
  </div>
</Base>
