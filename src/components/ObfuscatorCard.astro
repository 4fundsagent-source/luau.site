---
import { formatDate, formatDuration } from '~/lib/dates';
import { formatVersion, type ObfuscatorView } from '~/lib/data';
import { PROVING_DAYS } from '~/lib/score';
import { CODEBASE_MAX, PRICING_LABEL, RUNTIME_LABEL } from '~/lib/taxonomy';
import ExternalLinks from './ExternalLinks.astro';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import ScoreBar from './ScoreBar.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  o: ObfuscatorView;
  index?: number;
}
const { o, index = 0 } = Astro.props;
const d = o.data;
const s = o.latest.s;
const openChallenge = d.challenges.find((c) => c.status === 'open');

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const footer =
  s.status === 'broken'
    ? `Broken${s.daysToBreak !== undefined ? ` ${formatDuration(s.daysToBreak, s.fuzzy)} after release` : s.brokenOn ? ` ${formatDate(s.brokenOn)}` : ''}`
    : s.status === 'partial'
      ? `Partial coverage by ${plural(s.decisive.length, 'tool')}`
      : o.latest.provingDay !== undefined
        ? o.observedSince && !s.released
          ? `Earning credit · day ${o.latest.provingDay} of ${PROVING_DAYS}`
          : `New release · proving, day ${o.latest.provingDay} of ${PROVING_DAYS}`
        : o.openSource
          ? `Codebase graded ${o.codebase ?? '—'}/${CODEBASE_MAX}`
          : o.deobfuscators.length
            ? `${plural(o.deobfuscators.length, 'tool')} on older versions`
            : 'No public tools tracked';
---

<article
  class="surface card-hover relative flex min-w-0 flex-col p-5"
  data-item
  data-f-status={o.status}
  data-f-pricing={d.pricing}
  data-f-runtime={d.targets.join(' ')}
  data-search={`${d.name} ${d.vendor ?? ''} ${d.tagline} ${d.targets.map((t) => RUNTIME_LABEL[t]).join(' ')}`.toLowerCase()}
  data-s-score={o.score.unrated ? -1 : o.score.total}
  data-s-name={d.name.toLowerCase()}
  data-s-released={s.released?.date.getTime() ?? 0}
  data-s-broken={s.brokenOn?.date.getTime() ?? 0}
  data-reveal
  style={`--reveal-i:${index % 6}`}
>
  <div class="flex items-start gap-3">
    <Monogram name={d.name} id={o.id} transitionName={`mono-${o.id}`} />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-[0.9375rem] font-semibold tracking-tight text-fg">
        <a href={`/obfuscators/${o.id}`} class="card-link focus-visible:outline-none" style={`view-transition-name:title-${o.id}`}>{d.name}</a>
      </h3>
      <p class="num mt-0.5 truncate text-xs text-muted">
        {formatVersion(o.latest.version)} · {PRICING_LABEL[d.pricing]}
      </p>
    </div>
    <StatusBadge status={o.status} />
  </div>

  <p class="mt-3 line-clamp-2 min-h-10 text-sm leading-5 text-muted">{d.tagline}</p>

  <ScoreBar
    class="mt-4"
    score={o.score.total}
    tier={o.score.tier}
    confidence={o.score.confidence}
    provisional={o.score.provisional}
    unrated={o.score.unrated}
  />

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      openChallenge && (
        <span class="chip border-line-strong text-fg">
          <Icon name="trophy" size={12} />
          Open challenge{openChallenge.bounty ? ` · ${openChallenge.bounty}` : ''}
        </span>
      )
    }
    {d.targets.length ? d.targets.map((t) => <span class="chip">{RUNTIME_LABEL[t]}</span>) : <span class="chip">Runtime unknown</span>}
    {d.availability !== 'public' && <span class="chip">{d.availability === 'request-only' ? 'Request-only' : 'Closed'}</span>}
    {d.beta && <span class="chip">Beta</span>}
  </div>

  <div class="mt-4 flex min-h-8 items-center justify-between gap-3 border-t border-line pt-3">
    <span class="truncate text-xs text-muted">{footer}</span>
    <span class="card-raise -mr-1.5">
      <ExternalLinks name={d.name} website={d.website} repo={d.repo} docs={d.docs} discord={d.discord} />
    </span>
  </div>
</article>
