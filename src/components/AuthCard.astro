---
import type { AuthView } from '~/lib/data';
import { AUTH_FEATURE_LABEL, BYPASS_LABEL, PRICING_LABEL } from '~/lib/taxonomy';
import ExternalLinks from './ExternalLinks.astro';
import Monogram from './Monogram.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  a: AuthView;
  index?: number;
}
const { a, index = 0 } = Astro.props;
const x = a.data;
---

<article class="surface card-hover relative flex flex-col p-5" data-reveal style={`--reveal-i:${index % 6}`}>
  <div class="flex items-start gap-3">
    <Monogram name={x.name} id={a.id} transitionName={`mono-${a.id}`} />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-[0.9375rem] font-semibold tracking-tight">
        <a href={`/auth/${a.id}`} class="card-link">{x.name}</a>
      </h3>
      <p class="mt-0.5 text-xs text-muted">{PRICING_LABEL[x.pricing]}</p>
    </div>
    <StatusBadge status={a.status} label={BYPASS_LABEL[x.bypass.status]} />
  </div>
  <p class="mt-3 line-clamp-2 min-h-10 text-sm leading-5 text-muted">{x.tagline}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {x.features.map((f) => <span class="chip">{AUTH_FEATURE_LABEL[f]}</span>)}
  </div>
  <div class="mt-auto pt-4"></div>
  <div class="flex min-h-8 items-center justify-end border-t border-line pt-3">
    <span class="card-raise -mr-1.5">
      <ExternalLinks name={x.name} website={x.website} repo={x.repo} docs={x.docs} discord={x.discord} />
    </span>
  </div>
</article>
