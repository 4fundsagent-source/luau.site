---
/**
 * Events on a vertical rail: date, a dot coloured by kind, then the event.
 * `grouped` adds month headings (timeline page); `filterable` adds a kind
 * filter that works on the pre-rendered list; `segmentToggle` starts with only
 * commercial-obfuscator events and adds a switch to reveal open-source and legacy ones.
 */
import { formatDate } from '~/lib/dates';
import type { TimelineEvent } from '~/lib/data';
import { EVENT_LABEL, type EventKind } from '~/lib/taxonomy';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  events: TimelineEvent[];
  /** Group by month with headings (timeline page) or a flat list (home). */
  grouped?: boolean;
  /** Show a filter by event kind. */
  filterable?: boolean;
  /** Hide open-source & legacy events behind a switch. */
  segmentToggle?: boolean;
}
const { events, grouped = false, filterable = false, segmentToggle = false } = Astro.props;
const shownByDefault = (e: TimelineEvent) => !segmentToggle || e.segment === 'current';

const ICON: Record<EventKind, IconName> = {
  release: 'layers',
  break: 'unlock',
  deobfuscator: 'code',
  challenge: 'trophy',
  patch: 'shield',
  leak: 'unlock',
  shutdown: 'x',
  note: 'info',
};
/** Dot colour per kind; breaks are the loudest thing on the page. */
const TONE: Record<EventKind, string> = {
  break: 'var(--broken)',
  leak: 'var(--broken)',
  release: 'var(--fg)',
  deobfuscator: 'var(--accent)',
  challenge: 'var(--holding)',
  patch: 'var(--holding)',
  shutdown: 'var(--fg-subtle)',
  note: 'var(--fg-subtle)',
};

const groups = new Map<string, TimelineEvent[]>();
for (const e of events) {
  const key = grouped ? e.date.date.toLocaleString('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
  groups.set(key, [...(groups.get(key) ?? []), e]);
}

const FILTERS: { value: string; label: string; kinds: EventKind[] }[] = [
  { value: 'break', label: 'Breaks', kinds: ['break', 'leak'] },
  { value: 'deobfuscator', label: 'New tools', kinds: ['deobfuscator'] },
  { value: 'release', label: 'Releases', kinds: ['release', 'patch', 'shutdown'] },
  { value: 'challenge', label: 'Challenges', kinds: ['challenge'] },
];
const filterOf = (k: EventKind) => FILTERS.find((f) => f.kinds.includes(k))?.value ?? 'other';
const countOf = (list: TimelineEvent[]) => ({
  all: list.length,
  current: list.filter((e) => e.segment === 'current').length,
});
const counts = Object.fromEntries(FILTERS.map((f) => [f.value, countOf(events.filter((e) => f.kinds.includes(e.kind)))]));
const total = countOf(events);
const legacyCount = total.all - total.current;
/** Visible-by-default count; the script swaps it when the switch flips. */
const n = (c: { all: number; current: number }) => (segmentToggle ? c.current : c.all);
---

<div class="event-list" data-event-list>
  {
    filterable && (
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <div role="group" aria-label="Filter events" class="seg inline-flex h-9 max-w-full items-center overflow-x-auto rounded-lg border border-line bg-sunken p-0.5">
          <button type="button" class="seg-btn" data-kind="" aria-pressed="true">
            All{' '}
            <span class="num text-subtle" data-count-all={total.all} data-count-current={total.current}>
              {n(total)}
            </span>
          </button>
          {FILTERS.filter((f) => counts[f.value]!.all).map((f) => (
            <button type="button" class="seg-btn" data-kind={f.value} aria-pressed="false">
              {f.label}{' '}
              <span class="num text-subtle" data-count-all={counts[f.value]!.all} data-count-current={counts[f.value]!.current}>
                {n(counts[f.value]!)}
              </span>
            </button>
          ))}
        </div>
        {segmentToggle && legacyCount > 0 && (
          <button type="button" role="switch" aria-checked="false" class="switch inline-flex h-9 items-center gap-2.5 rounded-lg px-1 text-sm text-muted hover:text-fg" data-segment-switch>
            <span class="switch-track relative inline-block h-5 w-9 shrink-0 rounded-full border border-line-strong bg-sunken" aria-hidden="true">
              <span class="switch-thumb absolute top-0.5 left-0.5 size-3.5 rounded-full bg-subtle" />
            </span>
            Show open source &amp; legacy <span class="num text-subtle">{legacyCount}</span>
          </button>
        )}
      </div>
    )
  }

  <div class:list={[grouped ? 'space-y-8' : '']}>
    {
      [...groups].map(([month, items]) => {
        const visible = items.filter(shownByDefault);
        return (
          <section data-event-group hidden={visible.length === 0}>
            {month && (
              <h3 class="mb-2 flex items-center gap-3 text-sm font-semibold tracking-tight text-fg">
                {month}
                <span class="num text-xs font-normal text-subtle" data-group-count>
                  {visible.length} event{visible.length === 1 ? '' : 's'}
                </span>
                <span class="h-px flex-1 bg-line" aria-hidden="true" />
              </h3>
            )}
            <ol class="rail">
              {items.map((e, i) => (
                <li
                  hidden={!shownByDefault(e)}
                  data-segment={e.segment}
                  class:list={[
                    'rail-item grid gap-x-2 sm:gap-x-3',
                    e === visible[0] && 'rail-first',
                    e === visible.at(-1) && 'rail-last',
                    grouped
                      ? 'grid-cols-[3.5rem_1.5rem_minmax(0,1fr)] sm:grid-cols-[4.5rem_1.75rem_minmax(0,1fr)]'
                      : 'grid-cols-[5.25rem_1.5rem_minmax(0,1fr)] sm:grid-cols-[6rem_1.75rem_minmax(0,1fr)]',
                  ]}
                  data-kind={filterOf(e.kind)}
                  data-reveal
                  style={`--reveal-i:${Math.min(i, 6)}`}
                >
                  <time datetime={e.date.raw.replace('~', '')} class="num pt-[0.3125rem] text-right text-xs whitespace-nowrap text-subtle">
                    {grouped ? formatDate(e.date).replace(/,? \d{4}$/, '') : formatDate(e.date)}
                  </time>
                  <span class="relative flex justify-center" aria-hidden="true">
                    <span class="rail-line absolute top-0 bottom-0 w-px bg-line" />
                    <span
                      class:list={['relative mt-0.5 grid size-6 place-items-center rounded-full border bg-elev', e.kind === 'break' && 'text-white']}
                      style={e.kind === 'break' ? `background:${TONE[e.kind]};border-color:${TONE[e.kind]}` : `border-color:color-mix(in oklab, ${TONE[e.kind]} 45%, var(--line));color:${TONE[e.kind]}`}
                    >
                      <Icon name={ICON[e.kind]} size={12} />
                    </span>
                  </span>
                  <div class="min-w-0 pb-5">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                      {e.href ? (
                        <a href={e.href} class="font-medium text-fg hover:underline">
                          {e.title}
                        </a>
                      ) : (
                        <span class="font-medium text-fg">{e.title}</span>
                      )}
                      <span class="text-xs text-subtle">{EVENT_LABEL[e.kind]}</span>
                    </div>
                    {e.summary && <p class="mt-0.5 text-sm break-words text-muted">{e.summary}</p>}
                    {e.sources[0] && (
                      <a href={e.sources[0].url} rel="noopener nofollow" target="_blank" class="mt-1 inline-block text-xs text-subtle hover:text-fg">
                        {new URL(e.sources[0].url).hostname.replace(/^www\./, '')} ↗
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        );
      })
    }
  </div>
  {filterable && <p class="hidden text-sm text-muted" data-event-empty>No events of this kind yet.</p>}
</div>

<style>
  .switch-thumb {
    transition:
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 160ms;
  }
  .switch-track {
    transition:
      background-color 160ms,
      border-color 160ms;
  }
  .switch[aria-checked='true'] {
    color: var(--fg);
  }
  .switch[aria-checked='true'] .switch-track {
    background: var(--fg);
    border-color: var(--fg);
  }
  .switch[aria-checked='true'] .switch-thumb {
    transform: translateX(1rem);
    background: var(--bg-elev);
  }
  .switch:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The rail runs through every dot but stops at the last one. */
  .rail-item:first-child .rail-line,
  .rail-item.rail-first .rail-line {
    top: 0.75rem;
  }
  .rail-item:last-child .rail-line,
  .rail-item.rail-last .rail-line {
    bottom: auto;
    height: 0.75rem;
  }
  .rail-item:only-child .rail-line,
  .rail-item.rail-first.rail-last .rail-line {
    display: none;
  }
</style>

<script>
  import { withTransition } from '~/scripts/motion';

  for (const list of document.querySelectorAll<HTMLElement>('[data-event-list]')) {
    const buttons = [...list.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
    const toggle = list.querySelector<HTMLButtonElement>('[data-segment-switch]');
    if (!buttons.length && !toggle) continue;
    const items = [...list.querySelectorAll<HTMLElement>('li[data-kind]')];
    const groups = [...list.querySelectorAll<HTMLElement>('[data-event-group]')];
    const empty = list.querySelector<HTMLElement>('[data-event-empty]');
    const state = { kind: '', all: !toggle };

    const apply = () => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.kind === state.kind));
      toggle?.setAttribute('aria-checked', String(state.all));
      list.querySelectorAll<HTMLElement>('[data-count-all]').forEach((c) => {
        c.textContent = (state.all ? c.dataset.countAll : c.dataset.countCurrent) ?? '';
      });
      for (const li of items) {
        li.hidden = (Boolean(state.kind) && li.dataset.kind !== state.kind) || (!state.all && li.dataset.segment === 'legacy');
      }
      for (const g of groups) {
        const visible = [...g.querySelectorAll<HTMLElement>('li[data-kind]:not([hidden])')];
        g.hidden = visible.length === 0;
        const count = g.querySelector('[data-group-count]');
        if (count) count.textContent = `${visible.length} event${visible.length === 1 ? '' : 's'}`;
        // Keep the rail starting and ending on the visible dots.
        g.querySelectorAll('li').forEach((li) => li.classList.remove('rail-first', 'rail-last'));
        visible[0]?.classList.add('rail-first');
        visible.at(-1)?.classList.add('rail-last');
      }
      empty?.classList.toggle('hidden', items.some((li) => !li.hidden));
      const url = new URL(location.href);
      if (state.kind) url.searchParams.set('kind', state.kind);
      else url.searchParams.delete('kind');
      if (toggle && state.all) url.searchParams.set('all', '1');
      else url.searchParams.delete('all');
      history.replaceState(null, '', url);
    };

    const animate = (change: () => void) => {
      const visible = items.filter((li) => !li.hidden);
      visible.forEach((li, i) => (li.style.viewTransitionName = `event-${i}`));
      withTransition(() => {
        change();
        apply();
      }).then(() => items.forEach((li) => (li.style.viewTransitionName = '')));
    };

    for (const b of buttons) b.addEventListener('click', () => animate(() => (state.kind = b.dataset.kind ?? '')));
    toggle?.addEventListener('click', () => animate(() => (state.all = !state.all)));

    const params = new URL(location.href).searchParams;
    const kind = params.get('kind');
    if (kind && buttons.some((b) => b.dataset.kind === kind)) state.kind = kind;
    if (toggle && params.get('all') === '1') state.all = true;
    if (state.kind || (toggle && state.all)) apply();
  }
</script>
