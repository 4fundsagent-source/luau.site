---
/**
 * The Arms Race over a recent window (the last few months up to today).
 * One lane per obfuscator with activity in the window:
 *   - solid bars:  dated versions. Green from release while protected; once broken, red from the
 *                  deobfuscation up to today (its scripts stay breakable). Unbroken bars end when
 *                  the next version replaces them.
 *   - rolling:     obfuscators with unnumbered builds get one bar, red over the span of builds
 *                  that were deobfuscated and a red dot for a single deobfuscated build.
 *   - dashed bars: undated versions still standing, from an open public
 *                  challenge (or the start of observation) until today
 *   - crosses:     undated versions broken in the window
 * Lanes still standing come first, longest-standing on top; the rest follow by
 * their latest break. Diamonds below are newly published deobfuscators.
 * Static SVG at build time; a small script adds tooltips. The event log on
 * /timeline is the accessible list view of the same data.
 */
import { formatDate, formatDuration, formatPlainDate, parseDate } from '~/lib/dates';
import { formatVersion, type SiteData } from '~/lib/data';
import { STATUS_META, type DisplayStatus, type Status } from '~/lib/taxonomy';
import StatusIcon from './StatusIcon.astro';

interface Props {
  data: SiteData;
  compact?: boolean;
  /** Only show these obfuscators (ids). */
  only?: string[];
}
const { data, compact = false, only } = Astro.props;
const now = data.builtAt.getTime();
const DAY = 86_400_000;

// ---- window: from the first of the month a few months back, to just past today
const today = new Date(now);
const t0 = Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - (compact ? 3 : 4), 1);
const t1 = now + (compact ? 12 : 14) * DAY;

const W = 1000;
const LEFT = compact ? 132 : 160;
const RIGHT = 14;
const TOP = 30;
const ROW_H = 27;
const BAR_H = 10;
const CHAR = 6.3;
const x = (t: number) => LEFT + ((Math.min(Math.max(t, t0), t1) - t0) / (t1 - t0)) * (W - LEFT - RIGHT);

interface Item {
  kind: 'bar' | 'watch' | 'cross' | 'note' | 'range' | 'dot';
  label: string;
  start: number;
  end: number;
  status: Status;
  endKind: 'broken' | 'superseded' | 'ongoing';
  /** When a dated bar was broken: green before this point, red after. */
  breakAt?: number;
  /** The current, unbroken version: gets the pulsing end marker. */
  live?: boolean;
  clipped: boolean;
  trophy: boolean;
  row: number;
  tip: string[];
  href: string;
  /** Horizontal space the item and its label occupy, in px. */
  from: number;
  to: number;
  /** Label anchored at the bar's end because it would run off the right edge. */
  labelEnd?: boolean;
}
interface Lane {
  id: string;
  name: string;
  status: DisplayStatus;
  items: Item[];
  rows: number;
  standing: number;
  last: number;
}

const anchor = (id: string, version: string) => `/obfuscators/${id}#v-${version.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const rank = new Map(data.standing.map((s, i) => [s.obfuscator, i]));
const lanes: Lane[] = [];

for (const o of data.obfuscators) {
  if (only && !only.includes(o.id)) continue;
  const items: Item[] = [];
  const blank = { trophy: false, row: 0, from: 0, to: 0 };

  if (o.data.rolling) {
    // Unnumbered rolling builds: one bar from the first tracked build to today, red over the span
    // of builds that were deobfuscated, and a red dot where a single build was.
    const starts = o.versions.map((v) => (v.s.released ?? v.seen)?.date.getTime()).filter((t): t is number => t !== undefined);
    const start = starts.length ? Math.min(...starts) : (o.observedSince?.date.getTime() ?? t0);
    const live = o.latest.s.status === 'holding';
    items.push({
      ...blank,
      kind: 'bar',
      label: 'rolling builds',
      start,
      end: now,
      status: 'holding',
      endKind: 'ongoing',
      live,
      clipped: start < t0,
      href: `/obfuscators/${o.id}#versions`,
      tip: [
        `${o.data.name} · rolling builds`,
        'Unnumbered builds, updated continuously',
        live ? 'Current builds: no deobfuscation known' : 'Current builds: broken',
      ],
    });
    for (const v of o.versions) {
      if (v.s.status !== 'broken') continue;
      const shown = v.s.brokenOn ? ` · shown ${formatDate(v.s.brokenOn)}` : '';
      if (v.s.released && v.until) {
        items.push({
          ...blank,
          kind: 'range',
          label: '',
          start: v.s.released.date.getTime(),
          end: Math.max(v.until.date.getTime(), v.s.released.date.getTime() + DAY),
          status: 'broken',
          endKind: 'broken',
          clipped: v.s.released.date.getTime() < t0,
          href: anchor(o.id, v.version),
          tip: [
            `${o.data.name} ${v.version}`,
            `Builds from ${formatDate(v.s.released)} to ${formatDate(v.until)} deobfuscated${shown}`,
            ...(v.s.statusNote ? [v.s.statusNote] : []),
          ],
        });
      } else if (v.s.brokenOn) {
        items.push({
          ...blank,
          kind: 'dot',
          label: '',
          start: v.s.brokenOn.date.getTime(),
          end: v.s.brokenOn.date.getTime(),
          status: 'broken',
          endKind: 'broken',
          clipped: false,
          href: anchor(o.id, v.version),
          tip: [`${o.data.name} ${v.version}`, `Deobfuscated${shown}`, ...(v.s.statusNote ? [v.s.statusNote] : [])],
        });
      }
    }
  }

  // Dated versions, plus undated ones known to have been out by some date ("seen").
  const dated = o.data.rolling ? [] : o.versions.filter((v) => v.s.released || v.seen);
  const startOf = (v: (typeof o.versions)[number]) => (v.s.released ?? v.seen)!;

  dated.forEach((v, i) => {
    const start = startOf(v).date.getTime();
    const next = dated[i + 1] ? startOf(dated[i + 1]!).date.getTime() : undefined;
    const broken = v.s.status === 'broken' && v.s.brokenOn ? v.s.brokenOn.date.getTime() : undefined;
    // An unbroken bar runs until the next version replaces it (or today). A broken one stays red from
    // the break up to today, because scripts protected with it stay breakable; the green stretch
    // before the break shows how long it held. Versions broken and replaced before the window are left out.
    if (broken !== undefined && broken < t0 && (next ?? now) < t0) return;
    const end = Math.max(broken !== undefined ? now : (next ?? now), start + DAY);
    if (end < t0) return;
    const endKind = next && broken === undefined ? 'superseded' : 'ongoing';
    items.push({
      ...blank,
      kind: 'bar',
      label: formatVersion(v.version),
      start,
      end,
      // Dated breaks are drawn as a green-then-red bar; the rest keep their status colour.
      status: broken !== undefined ? 'holding' : v.s.status,
      breakAt: broken,
      endKind,
      live: broken === undefined && !next && v.s.status === 'holding',
      clipped: start < t0,
      href: anchor(o.id, v.version),
      tip: [
        `${o.data.name} ${formatVersion(v.version)}`,
        STATUS_META[v.s.status].label,
        v.s.released ? `Released ${formatDate(v.s.released)}` : `Out by ${formatDate(v.seen)} · release date unknown`,
        broken
          ? `Broken ${formatDate(v.s.brokenOn)}${v.s.daysToBreak !== undefined ? ` · held ${formatDuration(v.s.daysToBreak, v.s.fuzzy)}` : ''}`
          : endKind === 'superseded'
            ? `Superseded ${formatDate(startOf(dated[i + 1]!))}`
            : 'Still current',
        ...(broken !== undefined ? ['Scripts protected with it stay breakable'] : []),
        ...(v.s.manual && v.s.statusNote ? [v.s.statusNote] : []),
      ],
    });
  });

  // An open public challenge (on any current version), or an undated version being watched:
  // a dashed bar from the challenge or observation start to today.
  const st = o.data.rolling ? undefined : data.standing.find((s) => s.obfuscator === o.id && (s.challenge || s.reason === 'observation'));
  if (st) {
    const c = st.challenge;
    const watchStart = c ? parseDate(c.posted) : st.since;
    items.push({
      kind: 'watch',
      label: c
        ? `${/crackme/i.test(c.platform) ? 'crackme' : 'challenge'}${c.bounty ? ` · ${c.bounty} bounty` : ''} · unsolved`
        : `watching · day ${st.days}`,
      start: watchStart.date.getTime(),
      end: now,
      status: 'holding',
      endKind: 'ongoing',
      clipped: watchStart.date.getTime() < t0,
      trophy: Boolean(c),
      row: 0,
      href: c ? `/obfuscators/${o.id}#challenges` : `/obfuscators/${o.id}`,
      tip: [
        `${o.data.name} ${formatVersion(st.version)}`,
        `Unbroken for ${st.days} days`,
        c ? `Public ${c.platform} challenge posted ${formatDate(watchStart)}` : `Watched since ${formatDate(st.since)}`,
        ...(c ? [`Still unsolved${c.bounty ? ` · ${c.bounty} bounty` : ''}`] : []),
      ],
      from: 0,
      to: 0,
    });
  }

  // Undated versions broken inside the window, grouped by day.
  const crosses = new Map<string, typeof o.versions>();
  for (const v of o.data.rolling ? [] : o.versions) {
    if (v.s.released || v.seen || v.s.status !== 'broken' || !v.s.brokenOn) continue;
    if (v.s.brokenOn.date.getTime() < t0) continue;
    crosses.set(v.s.brokenOn.raw, [...(crosses.get(v.s.brokenOn.raw) ?? []), v]);
  }
  for (const group of crosses.values()) {
    const when = group[0]!.s.brokenOn!;
    const decisive = group[0]!.s.decisive[0];
    const tool = decisive ? data.deob.get(decisive.deobfuscator) : undefined;
    items.push({
      kind: 'cross',
      label: group.map((v) => formatVersion(v.version)).join(', '),
      start: when.date.getTime(),
      end: when.date.getTime(),
      status: 'broken',
      endKind: 'broken',
      clipped: false,
      trophy: false,
      row: 0,
      href: anchor(o.id, group[0]!.version),
      tip: [
        `${o.data.name} ${group.map((v) => formatVersion(v.version)).join(', ')}`,
        'Broken',
        `${formatDate(when)}${tool ? ` · ${tool.data.name}` : ''}`,
        'Release date unknown',
      ],
      from: 0,
      to: 0,
    });
  }
  // The current version is broken but nobody knows when: say so instead of leaving the lane empty.
  const latest = o.latest;
  if (!o.data.rolling && latest.s.status === 'broken' && !latest.s.brokenOn && !latest.s.released) {
    const tool = latest.s.decisive[0] ? data.deob.get(latest.s.decisive[0].deobfuscator) : undefined;
    items.push({
      kind: 'note',
      label: `${formatVersion(latest.version)} broken · date unknown`,
      start: t0,
      end: t0,
      status: 'broken',
      endKind: 'broken',
      clipped: false,
      trophy: false,
      row: 0,
      href: anchor(o.id, latest.version),
      tip: [
        `${o.data.name} ${formatVersion(latest.version)}`,
        'Broken',
        `${tool ? `${tool.data.name} · ` : ''}date of the break unknown`,
        'Release date unknown',
      ],
      from: 0,
      to: 0,
    });
  }
  if (!items.length) continue;

  // Pack items into rows so neither bars nor their labels ever overlap.
  for (const it of items) {
    const x0 = x(it.start);
    const lw = it.label.length * CHAR + (it.trophy ? 16 : 0);
    if (it.kind === 'note') {
      it.from = x0;
      it.to = x0 + 22 + lw + 10;
    } else if (it.kind === 'cross') {
      it.from = x0 - 8;
      it.to = Math.max(x0 + 8, x0 - 6 + lw) + 10;
    } else if (x0 + lw > W - RIGHT) {
      // Too close to the right edge: the label ends where the bar ends.
      it.labelEnd = true;
      it.from = Math.min(x0, x(it.end) - lw) - 2;
      it.to = x(it.end) + 10;
    } else {
      it.from = x0 - 2;
      it.to = Math.max(x(it.end) + (it.endKind === 'broken' ? 8 : 4), x0 + lw) + 10;
    }
  }
  // A rolling lane is a single bar with its breaks drawn on top, in item order.
  const rowEnds: number[] = o.data.rolling ? [W] : [];
  if (!o.data.rolling) {
    items.sort((a, b) => a.from - b.from);
    for (const it of items) {
      let r = rowEnds.findIndex((e) => e <= it.from);
      if (r === -1) r = rowEnds.length;
      rowEnds[r] = it.to;
      it.row = r;
    }
  }

  const ongoing = items.some((it) => it.live);
  lanes.push({
    id: o.id,
    name: o.data.name,
    status: o.status,
    items,
    rows: rowEnds.length,
    standing: ongoing ? (rank.get(o.id) ?? 999) : Infinity,
    // Most recent break first among lanes that are not standing.
    last: Math.max(0, ...items.map((it) => it.breakAt ?? (it.kind === 'range' || it.kind === 'dot' || it.kind === 'cross' ? it.start : 0))),
  });
}
// Still standing first (longest-standing on top), then by most recent break.
lanes.sort((a, b) => a.standing - b.standing || b.last - a.last || a.name.localeCompare(b.name));

// ---- tools published inside the window
const tools = data.deobfuscators
  .filter((d) => d.firstSeen && (!only || d.coverage.some((c) => only.includes(c.obfuscator))))
  .map((d) => ({ id: d.id, name: d.data.name, t: d.firstSeen!.date.getTime(), label: formatDate(d.firstSeen) }))
  .sort((a, b) => a.t - b.t);
const earlierTools = tools.filter((t) => t.t < t0).length;
const shownTools = tools
  .filter((t) => t.t >= t0)
  .map((t) => ({ ...t, row: 0 }));
const toolRowEnds: number[] = [];
for (const t of shownTools) {
  let r = toolRowEnds.findIndex((e) => e <= x(t.t) - 8);
  if (r === -1) r = toolRowEnds.length;
  toolRowEnds[r] = x(t.t) + 8;
  t.row = r;
}

// ---- vertical layout
let y = TOP;
const laneLayout = lanes.map((l) => {
  const h = 10 + l.rows * ROW_H + 6;
  const top = y;
  y += h;
  return { ...l, top, h };
});
const rowTop = (laneTop: number, row: number) => laneTop + 10 + row * ROW_H + 13;
const toolTop = y;
const toolH = tools.length ? 18 + Math.max(toolRowEnds.length, 1) * 15 + (earlierTools ? 12 : 0) : 0;
const H = y + toolH + 6;

// ---- month ticks
const ticks: { t: number; label: string }[] = [];
for (let m = new Date(t0); m.getTime() < t1; m = new Date(Date.UTC(m.getUTCFullYear(), m.getUTCMonth() + 1, 1))) {
  const first = ticks.length === 0 || m.getUTCMonth() === 0;
  ticks.push({
    t: m.getTime(),
    label: m.toLocaleString('en', { month: 'short', timeZone: 'UTC' }) + (first ? ` ${m.getUTCFullYear()}` : ''),
  });
}
const nowX = x(now);
const visibleTicks = ticks.filter((tk) => nowX - x(tk.t) > 52 || x(tk.t) > nowX + 8);
const windowLabel = new Date(t0).toLocaleString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const earlierEvents = data.events.filter(
  (e) => e.date.date.getTime() < t0 && (!only || (e.obfuscator ? only.includes(e.obfuscator) : e.segment === 'current')),
).length;

const R = 4;
function barPath(x0: number, x1: number, yTop: number, roundLeft: boolean, roundRight: boolean) {
  const w = Math.max(x1 - x0, 3);
  const rl = roundLeft ? Math.min(R, w / 2, BAR_H / 2) : 0;
  const rr = roundRight ? Math.min(R, w / 2, BAR_H / 2) : 0;
  const xe = x0 + w;
  const yb = yTop + BAR_H;
  return (
    `M${x0 + rl},${yTop}H${xe - rr}Q${xe},${yTop} ${xe},${yTop + rr}V${yb - rr}Q${xe},${yb} ${xe - rr},${yb}` +
    `H${x0 + rl}Q${x0},${yb} ${x0},${yb - rl}V${yTop + rl}Q${x0},${yTop} ${x0 + rl},${yTop}Z`
  );
}
const uid = `arc${compact ? 'c' : 'f'}`;
const STATUS_DOT: Record<DisplayStatus, string> = {
  holding: 'var(--holding)',
  open: 'var(--open)',
  partial: 'var(--partial)',
  broken: 'var(--broken)',
};
---

<figure class="arms-race relative" data-chart data-reveal>
  <div class="relative">
  <div class="overflow-x-auto" data-chart-scroll>
    <svg viewBox={`0 0 ${W} ${H}`} class="block w-full min-w-[720px]" aria-labelledby={`${uid}-title`}>
      <title id={`${uid}-title`}>
        Timeline since {formatPlainDate(new Date(t0))} of {lanes.length} obfuscators: which versions are still standing, which were broken, and when new deobfuscators appeared.
      </title>
      <defs>
        <linearGradient id={`${uid}-fade`} x1="0" x2="1">
          <stop offset="0" style="stop-color:var(--bg-elev);stop-opacity:1"></stop>
          <stop offset="1" style="stop-color:var(--bg-elev);stop-opacity:0"></stop>
        </linearGradient>
      </defs>

      <!-- grid -->
      {
        visibleTicks.map((tk) => (
          <g>
            <line x1={x(tk.t)} x2={x(tk.t)} y1={TOP - 8} y2={H - 4} stroke="var(--line)" stroke-width="1" />
            <text x={x(tk.t) + 5} y={TOP - 14} class="tick">
              {tk.label}
            </text>
          </g>
        ))
      }

      <!-- lanes -->
      {
        laneLayout.map((l, li) => {
          const nameY = rowTop(l.top, 0) + BAR_H / 2 + 4.5;
          return (
            <g>
              {li > 0 && <line x1="0" x2={W} y1={l.top} y2={l.top} stroke="var(--line)" stroke-width="1" />}
              <a href={`/obfuscators/${l.id}`} class="lane-link">
                <circle cx="4" cy={nameY - 4.5} r="3.5" fill={STATUS_DOT[l.status]} />
                <text x="14" y={nameY} class="lane">
                  {l.name}
                </text>
              </a>
              {l.items.map((it, ii) => {
                const delay = `--d:${li * 90 + ii * 60}ms`;
                const yTop = rowTop(l.top, it.row);
                const x0 = x(it.start);
                const x1 = x(it.end);
                const cy = yTop + BAR_H / 2;
                if (it.kind === 'cross') {
                  return (
                    <a href={it.href} class="bar" data-tip={it.tip.join('\n')} aria-label={it.tip.join(', ')}>
                      <rect x={x0 - 9} y={yTop - 14} width={Math.max(18, it.to - it.from - 10)} height={BAR_H + 20} fill="transparent" />
                      <g class="marker" style={delay}>
                        <circle cx={x0} cy={cy} r="6.5" fill="var(--broken)" stroke="var(--bg-elev)" stroke-width="2" />
                        <path d={`M${x0 - 2.4},${cy - 2.4}l4.8,4.8M${x0 + 2.4},${cy - 2.4}l-4.8,4.8`} stroke="var(--bg-elev)" stroke-width="1.5" stroke-linecap="round" />
                      </g>
                      <text x={x0 - 6} y={yTop - 5} class="vlabel">
                        {it.label}
                      </text>
                    </a>
                  );
                }
                if (it.kind === 'range') {
                  return (
                    <a href={it.href} class="bar" data-tip={it.tip.join('\n')} data-status="broken" aria-label={it.tip.join(', ')}>
                      <rect x={x0 - 2} y={yTop - 8} width={Math.max(x1 - x0, 3) + 4} height={BAR_H + 16} fill="transparent" />
                      <path d={barPath(x0, x1, yTop, !it.clipped, true)} fill="var(--broken)" class="bar-fill" style={delay} />
                    </a>
                  );
                }
                if (it.kind === 'dot') {
                  return (
                    <a href={it.href} class="bar" data-tip={it.tip.join('\n')} aria-label={it.tip.join(', ')}>
                      <rect x={x0 - 9} y={yTop - 8} width="18" height={BAR_H + 16} fill="transparent" />
                      <g class="marker" style={delay}>
                        <circle cx={x0} cy={cy} r="6.5" fill="var(--broken)" stroke="var(--bg-elev)" stroke-width="2" />
                        <path d={`M${x0 - 2.4},${cy - 2.4}l4.8,4.8M${x0 + 2.4},${cy - 2.4}l-4.8,4.8`} stroke="var(--bg-elev)" stroke-width="1.5" stroke-linecap="round" />
                      </g>
                    </a>
                  );
                }
                if (it.kind === 'note') {
                  const nx = x0 + 9;
                  return (
                    <a href={it.href} class="bar" data-tip={it.tip.join('\n')} aria-label={it.tip.join(', ')}>
                      <rect x={x0} y={yTop - 8} width={it.to - it.from - 10} height={BAR_H + 16} fill="transparent" />
                      <g class="marker" style={delay}>
                        <circle cx={nx} cy={cy} r="6.5" fill="var(--broken)" stroke="var(--bg-elev)" stroke-width="2" />
                        <path d={`M${nx - 2.4},${cy - 2.4}l4.8,4.8M${nx + 2.4},${cy - 2.4}l-4.8,4.8`} stroke="var(--bg-elev)" stroke-width="1.5" stroke-linecap="round" />
                      </g>
                      <text x={nx + 12} y={cy + 3.5} class="vlabel">
                        {it.label}
                      </text>
                    </a>
                  );
                }
                const watch = it.kind === 'watch';
                return (
                  <a href={it.href} class="bar" data-tip={it.tip.join('\n')} data-status={it.status} aria-label={it.tip.join(', ')}>
                    <rect x={x0 - 2} y={yTop - 14} width={Math.max(x1 - x0, 3) + 12} height={BAR_H + 20} fill="transparent" />
                    <path
                      d={barPath(x0, x1, yTop, !it.clipped, it.endKind !== 'superseded')}
                      fill={watch ? 'color-mix(in oklab, var(--holding) 20%, transparent)' : `var(--${it.status})`}
                      stroke={watch ? 'var(--holding)' : 'none'}
                      stroke-width={watch ? 1.25 : 0}
                      stroke-dasharray={watch ? '4 3' : undefined}
                      class="bar-fill"
                      style={delay}
                    />
                    {it.breakAt !== undefined && x1 - x(it.breakAt) > 0.5 && (
                      <path
                        d={barPath(x(it.breakAt), x1, yTop, false, it.endKind !== 'superseded')}
                        fill="var(--broken)"
                        class="bar-fill"
                        style={delay}
                      />
                    )}
                    {it.clipped && <rect x={x0} y={yTop - 1} width="22" height={BAR_H + 2} fill={`url(#${uid}-fade)`} />}
                    {it.breakAt !== undefined && (
                      <g class="marker" style={delay}>
                        <circle cx={x(it.breakAt)} cy={cy} r="6.5" fill="var(--broken)" stroke="var(--bg-elev)" stroke-width="2" />
                        <path
                          d={`M${x(it.breakAt) - 2.4},${cy - 2.4}l4.8,4.8M${x(it.breakAt) + 2.4},${cy - 2.4}l-4.8,4.8`}
                          stroke="var(--bg-elev)"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </g>
                    )}
                    {it.live && (
                      <g class="marker" style={delay}>
                        <circle cx={x1} cy={cy} r="7" fill="var(--holding)" class="live-ring" />
                        <circle cx={x1} cy={cy} r="4" fill="var(--holding)" stroke="var(--bg-elev)" stroke-width="1.5" />
                      </g>
                    )}
                    {it.trophy && (
                      <g transform={`translate(${x0 + 1} ${yTop - 15}) scale(0.5)`} fill="none" stroke="var(--fg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                      </g>
                    )}
                    <text
                      x={it.labelEnd ? x1 : x0 + (it.trophy ? 16 : 1)}
                      y={yTop - 5}
                      text-anchor={it.labelEnd ? 'end' : 'start'}
                      class:list={['vlabel', watch && 'strong']}
                    >
                      {it.label}
                    </text>
                  </a>
                );
              })}
            </g>
          );
        })
      }

      <!-- deobfuscator releases -->
      {
        tools.length > 0 && (
          <g>
            <line x1="0" x2={W} y1={toolTop} y2={toolTop} stroke="var(--line)" stroke-width="1" />
            <text x="14" y={toolTop + 22} class="lane muted">
              New tools
            </text>
            {earlierTools > 0 && (
              <text x="14" y={toolTop + 36} class="vlabel">
                +{earlierTools} before {windowLabel}
              </text>
            )}
            {shownTools.map((t) => {
              const ty = toolTop + 12 + t.row * 15;
              return (
                <a href={`/deobfuscators/${t.id}`} class="bar" data-tip={`${t.name}\nPublished ${t.label}`} aria-label={`${t.name}, published ${t.label}`}>
                  <rect x={x(t.t) - 8} y={ty - 1} width="16" height="16" fill="transparent" />
                  <path d={`M${x(t.t)},${ty}l6,7l-6,7l-6,-7Z`} fill="var(--fg)" stroke="var(--bg-elev)" stroke-width="2" class="marker" style={`--d:${laneLayout.length * 90}ms`} />
                </a>
              );
            })}
          </g>
        )
      }

      <!-- today -->
      <line x1={nowX} x2={nowX} y1={TOP - 8} y2={H - 4} stroke="var(--fg)" stroke-width="1" stroke-opacity="0.5" class="now-line" style={`--len:${H}`} />
      <g>
        <rect x={nowX - 22} y={TOP - 27} width="44" height="17" rx="8.5" fill="var(--fg)" />
        <text x={nowX} y={TOP - 15} class="tick today" text-anchor="middle">
          Today
        </text>
      </g>
    </svg>
  </div>
  <!-- Lane names stay visible while a narrow screen scrolls the chart sideways. -->
  <div class="lane-names pointer-events-none absolute inset-y-0 left-0 w-24" aria-hidden="true">
    {
      laneLayout.map((l) => (
        <span class="absolute left-0 flex -translate-y-1/2 items-center gap-1.5 text-xs font-medium text-fg" style={`top:${((rowTop(l.top, 0) + BAR_H / 2) / H) * 100}%`}>
          <span class="size-1.5 shrink-0 rounded-full" style={`background:${STATUS_DOT[l.status]}`} />
          <span class="truncate">{l.name}</span>
        </span>
      ))
    }
  </div>
  </div>

  <figcaption class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted">
    {
      (
        [
          ['holding', 'Protected'],
          ['partial', STATUS_META.partial.label],
          ['broken', 'Broken: red from the deobfuscation on, since its scripts stay breakable'],
        ] as const
      ).map(([s, label]) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-4 rounded-[3px]" style={`background:var(--${s})`} />
          <StatusIcon status={s} />
          {label}
        </span>
      ))
    }
    <span class="inline-flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-4 rounded-[3px] border border-dashed" style="border-color:var(--holding);background:color-mix(in oklab, var(--holding) 20%, transparent)"></span>
      Unbroken (public challenge or watched)
    </span>
    <span class="inline-flex items-center gap-1.5">
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <circle cx="6" cy="6" r="6" fill="var(--broken)" />
        <path d="M3.8,3.8l4.4,4.4M8.2,3.8l-4.4,4.4" stroke="var(--bg-elev)" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      Deobfuscated
    </span>
    {
      lanes.some((l) => data.obf.get(l.id)?.data.rolling) && (
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-4 rounded-[3px]" style="background:linear-gradient(90deg, var(--holding) 0 35%, var(--broken) 35% 65%, var(--holding) 65%)" />
          Rolling builds: one bar, red over builds that were deobfuscated
        </span>
      )
    }
    {
      tools.length > 0 && (
        <span class="inline-flex items-center gap-1.5">
          <svg width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
            <path d="M5,0l5,6l-5,6l-5,-6Z" fill="var(--fg)" />
          </svg>
          Deobfuscator published
        </span>
      )
    }
    <span class="text-subtle sm:ml-auto">
      {earlierEvents > 0 && !compact ? `${earlierEvents} earlier events in the log · ` : ''}Built {formatPlainDate(data.builtAt)}
    </span>
  </figcaption>

  <div data-tooltip aria-hidden="true" class="pointer-events-none absolute z-10 rounded-lg border border-line-strong bg-elev px-3 py-2 text-xs shadow-lift"></div>
</figure>

<style>
  .arms-race :global(.tick) {
    font: 500 11px var(--font-mono);
    fill: var(--fg-subtle);
  }
  .arms-race :global(.tick.today) {
    fill: var(--bg);
    font-weight: 600;
  }
  .arms-race :global(.lane) {
    font: 500 13px var(--font-sans);
    fill: var(--fg);
  }
  .arms-race :global(.lane.muted) {
    fill: var(--fg-subtle);
  }
  .arms-race :global(.lane-link:hover .lane),
  .arms-race :global(.lane-link:focus-visible .lane) {
    text-decoration: underline;
  }
  .arms-race :global(.vlabel) {
    font: 500 10.5px var(--font-mono);
    fill: var(--fg-muted);
  }
  .arms-race :global(.vlabel.strong) {
    fill: var(--fg);
  }
  .arms-race :global(.bar) {
    cursor: pointer;
    outline: none;
  }
  .arms-race :global(.bar .bar-fill) {
    transition: opacity 150ms;
  }
  .arms-race :global(.bar:hover .bar-fill),
  .arms-race :global(.bar:focus-visible .bar-fill) {
    opacity: 0.8;
  }
  .arms-race :global(.bar:hover .vlabel),
  .arms-race :global(.bar:focus-visible .vlabel) {
    fill: var(--fg);
    text-decoration: underline;
  }
  .arms-race :global(.live-ring) {
    opacity: 0;
  }
  .lane-names {
    opacity: 0;
    background: linear-gradient(to right, var(--bg-elev) 62%, transparent);
    transition: opacity 200ms;
  }
  [data-scrolled] > .lane-names {
    opacity: 1;
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-chart]')) {
    // On narrow screens the chart scrolls sideways: start at today, where the action is.
    const scroller = fig.querySelector<HTMLElement>('[data-chart-scroll]');
    if (scroller) {
      const sync = () => scroller.parentElement!.toggleAttribute('data-scrolled', scroller.scrollLeft > 24);
      scroller.addEventListener('scroll', sync, { passive: true });
      scroller.scrollLeft = scroller.scrollWidth;
      sync();
    }

    const tip = fig.querySelector<HTMLElement>('[data-tooltip]')!;
    const show = (el: Element, cx: number, cy: number) => {
      const lines = (el.getAttribute('data-tip') ?? '').split('\n');
      tip.replaceChildren(
        ...lines.map((line, i) => {
          const p = document.createElement('p');
          p.textContent = line;
          p.className = i === 0 ? 'font-medium text-fg' : i === 1 ? 'text-fg' : 'text-muted';
          return p;
        }),
      );
      tip.setAttribute('data-show', '');
      const box = fig.getBoundingClientRect();
      const w = tip.offsetWidth;
      const left = Math.min(Math.max(8, cx - box.left + 12), box.width - w - 8);
      tip.style.left = `${left}px`;
      tip.style.top = `${cy - box.top + 14}px`;
    };
    const hide = () => tip.removeAttribute('data-show');
    fig.querySelectorAll('[data-tip]').forEach((el) => {
      el.addEventListener('pointermove', (e) => show(el, (e as PointerEvent).clientX, (e as PointerEvent).clientY));
      el.addEventListener('pointerleave', hide);
      el.addEventListener('focus', () => {
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.bottom - 8);
      });
      el.addEventListener('blur', hide);
    });
  }
</script>
