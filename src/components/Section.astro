---
interface Props {
  id?: string;
  title: string;
  description?: string;
  class?: string;
}
const { id, title, description, class: className } = Astro.props;
---

<section id={id} class:list={['scroll-mt-24', className]}>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <div>
      <h2 class="text-lg font-semibold tracking-tight text-fg">{title}</h2>
      {description && <p class="mt-1 text-sm text-muted">{description}</p>}
    </div>
    <slot name="action" />
  </div>
  <slot />
</section>
