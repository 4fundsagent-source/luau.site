---
import { formatDate } from '~/lib/dates';
import { githubStats } from '~/lib/github';
import { formatVersion, listRuntimes, type DeobfuscatorView } from '~/lib/data';
import { ACCESS_LABEL, DEOB_KIND_LABEL, MAINTENANCE_LABEL, OUTPUT_META } from '~/lib/taxonomy';
import ExternalLinks from './ExternalLinks.astro';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import ScoreBar from './ScoreBar.astro';
import StatusIcon from './StatusIcon.astro';

interface Props {
  d: DeobfuscatorView;
  index?: number;
}
const { d, index = 0 } = Astro.props;
const x = d.data;
const gh = githubStats(x.repo);

// Group coverage by obfuscator: "Luraph v15 · v14.7–v14.9 (partial)"
const groups = new Map<string, { name: string; breaks: string[]; partials: string[] }>();
for (const c of d.coverage) {
  const g = groups.get(c.obfuscator) ?? { name: c.obfuscatorName, breaks: [], partials: [] };
  (c.effect === 'break' ? g.breaks : g.partials).push(formatVersion(c.version));
  groups.set(c.obfuscator, g);
}
const lines = [...groups.values()].flatMap((g) => [
  ...(g.breaks.length ? [{ status: 'broken' as const, name: g.name, versions: g.breaks, note: 'readable source' }] : []),
  ...(g.partials.length ? [{ status: 'partial' as const, name: g.name, versions: g.partials, note: 'partial' }] : []),
]);
---

<article
  class="surface card-hover relative flex min-w-0 flex-col p-5"
  data-item
  data-f-access={x.access}
  data-f-output={x.outputLevel}
  data-f-target={[...groups.keys()].join(' ')}
  data-f-maintenance={x.maintenance}
  data-f-kind={x.kind}
  data-search={`${x.name} ${x.author} ${x.tagline} ${[...groups.values()].map((g) => g.name).join(' ')}`.toLowerCase()}
  data-s-name={x.name.toLowerCase()}
  data-s-score={d.score.total}
  data-s-first={d.firstSeen?.date.getTime() ?? 0}
  data-s-coverage={d.coverage.length}
  data-reveal
  style={`--reveal-i:${index % 6}`}
>
  <div class="flex items-start gap-3">
    <Monogram name={x.name} id={d.id} transitionName={`mono-${d.id}`} />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-[0.9375rem] font-semibold tracking-tight text-fg">
        <a href={`/deobfuscators/${d.id}`} class="card-link focus-visible:outline-none" style={`view-transition-name:title-${d.id}`}>{x.name}</a>
      </h3>
      <p class="mt-0.5 truncate text-xs text-muted">by {x.author} · {ACCESS_LABEL[x.access]}{x.license ? ` (${x.license})` : ''}</p>
    </div>
    <span class="chip">{x.kind === 'deobfuscator' ? MAINTENANCE_LABEL[x.maintenance] : DEOB_KIND_LABEL[x.kind]}</span>
  </div>

  <p class="mt-3 line-clamp-2 min-h-10 text-sm leading-5 text-muted">{x.tagline}</p>

  <ScoreBar class="mt-4" score={d.score.total} tier={d.score.tier} label="Deobfuscator Score" />

  {
    x.kind === 'decompiler' && (
      <p class="mt-4 flex items-start gap-2 text-sm text-fg">
        <Icon name="code" size={14} class="mt-[0.2rem] shrink-0 text-subtle" />
        <span>
          Decompiles {listRuntimes(x.decompiles)} bytecode
          <span class="text-subtle"> — {MAINTENANCE_LABEL[x.maintenance].toLowerCase()}</span>
        </span>
      </p>
    )
  }

  {
    x.kind === 'env-logger' && (
      <p class="mt-4 flex items-start gap-2 text-sm text-fg">
        <Icon name="code" size={14} class="mt-[0.2rem] shrink-0 text-subtle" />
        <span>
          Logs what a script does at runtime
          <span class="text-subtle"> — {MAINTENANCE_LABEL[x.maintenance].toLowerCase()}</span>
        </span>
      </p>
    )
  }

  {
    lines.length > 0 && (
      <ul class="mt-4 space-y-1.5 text-sm" aria-label="Coverage">
        {
          lines.map((l) => (
            <li class="flex items-start gap-2">
              <span class="mt-[0.3rem]">
                <StatusIcon status={l.status} />
              </span>
              <span class="min-w-0 break-words text-fg">
                {l.name} <span class="num text-muted">{l.versions.join(' · ')}</span>
                <span class="text-subtle"> — {l.note}</span>
              </span>
            </li>
          ))
        }
      </ul>
    )
  }

  <div class="mt-auto pt-4" />
  <div class="flex min-h-8 items-center justify-between gap-3 border-t border-line pt-3">
    <span class="truncate text-xs text-muted">
      {OUTPUT_META[x.outputLevel].label}{d.firstSeen ? ` · since ${formatDate(d.firstSeen)}` : ''}{gh ? ` · ★ ${gh.stars.toLocaleString()}` : ''}
    </span>
    <span class="card-raise -mr-1.5">
      <ExternalLinks name={x.name} website={x.website} repo={x.repo} docs={x.docs} discord={x.discord} />
    </span>
  </div>
</article>
