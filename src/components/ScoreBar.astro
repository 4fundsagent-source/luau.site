---
import type { Tier } from '~/lib/score';

interface Props {
  score: number;
  tier: Tier;
  confidence?: number;
  provisional?: boolean;
  /** Too little data to rate: show a placeholder instead of a number. */
  unrated?: boolean;
  size?: 'sm' | 'lg';
  /** Name of the score in the tooltip. */
  label?: string;
  class?: string;
}
const { score, tier, confidence, provisional = false, unrated = false, size = 'sm', label = 'Security Score', class: className } = Astro.props;
const backed = confidence !== undefined ? ` · ${Math.round(confidence * 100)}% backed by data` : '';
const title = unrated
  ? `Not enough data to rate${backed}`
  : `${label} ${score}/100 · tier ${tier}${backed}${provisional ? ' · provisional' : ''}`;
const track = size === 'sm' ? 'h-1.5' : 'h-2';
---

<div class:list={['flex items-center gap-3', className]} title={title}>
  {
    unrated ? (
      <>
        <div class:list={['flex-1 rounded-full border border-dashed border-line-strong', track]} />
        <span class="text-xs whitespace-nowrap text-subtle">Unrated</span>
      </>
    ) : (
      <>
        <div
          class:list={['relative flex-1 overflow-hidden rounded-full bg-sunken', track]}
          role="meter"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={score}
          aria-label="Security Score"
        >
          <div
            class:list={['score-fill absolute inset-y-0 left-0 rounded-full', provisional && 'opacity-50']}
            style={`width:${Math.max(2, score)}%;background:var(--fg)`}
          />
        </div>
        <span
          class:list={['num text-right font-medium text-fg', size === 'sm' ? 'w-6 text-sm' : 'w-8 text-base']}
          data-countup={score}
        >
          {score}
        </span>
        <span
          class:list={[
            'num grid place-items-center rounded-md border font-semibold text-fg',
            provisional ? 'border-dashed border-line-strong' : 'border-line',
            size === 'sm' ? 'size-5 text-[0.6875rem]' : 'size-6 text-xs',
          ]}
          aria-label={`Tier ${tier}${provisional ? ', provisional' : ''}`}
        >
          {tier}
        </span>
      </>
    )
  }
</div>
