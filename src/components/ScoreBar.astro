---
import type { Tier } from '~/lib/score';

interface Props {
  score: number;
  tier: Tier;
  confidence?: number;
  provisional?: boolean;
  size?: 'sm' | 'lg';
  class?: string;
}
const { score, tier, confidence, provisional = false, size = 'sm', class: className } = Astro.props;
const title =
  `Security Score ${score}/100 · tier ${tier}` +
  (confidence !== undefined ? ` · ${Math.round(confidence * 100)}% backed by data` : '') +
  (provisional ? ' · provisional' : '');
---

<div
  class:list={['flex items-center gap-3', className]}
  title={title}
>
  <div
    class:list={['relative flex-1 overflow-hidden rounded-full bg-sunken', size === 'sm' ? 'h-1.5' : 'h-2']}
    role="meter"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={score}
    aria-label="Security Score"
  >
    <div
      class:list={['score-fill absolute inset-y-0 left-0 rounded-full', provisional ? 'opacity-50' : '']}
      style={`width:${Math.max(2, score)}%;background:var(--fg)`}
    >
    </div>
  </div>
  <span class:list={['num font-medium text-fg', size === 'sm' ? 'w-6 text-right text-sm' : 'w-8 text-right text-base']}>{score}</span>
  <span
    class:list={[
      'num grid place-items-center rounded-md border font-semibold text-fg',
      provisional ? 'border-dashed border-line-strong' : 'border-line',
      size === 'sm' ? 'size-5 text-[0.6875rem]' : 'size-6 text-xs',
    ]}
    aria-label={`Tier ${tier}${provisional ? ', provisional' : ''}`}>{tier}</span
  >
</div>
