---
/** The mark: a moon ("lua") that is half solid, half hatched — half protected, half exposed. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 24 24" class={className} aria-hidden="true">
  <defs>
    <pattern id={`${uid}h`} width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="2.6" stroke="currentColor" stroke-width="1.1"></line>
    </pattern>
    <clipPath id={`${uid}c`}><circle cx="12" cy="12" r="7.25"></circle></clipPath>
  </defs>
  <rect x="0.75" y="0.75" width="22.5" height="22.5" rx="6.5" fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="1.5"></rect>
  <g clip-path={`url(#${uid}c)`}>
    <rect x="4" y="4" width="8" height="16" fill="currentColor"></rect>
    <rect x="12" y="4" width="8" height="16" fill={`url(#${uid}h)`}></rect>
  </g>
  <circle cx="12" cy="12" r="7.25" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
</svg>
