---
interface Props {
  name: string;
  id: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  transitionName?: string;
}
const { name, id, size = 'md', class: className, transitionName } = Astro.props;

const words = name.replace(/[^A-Za-z0-9 ]/g, ' ').trim().split(/\s+/);
const letters = (words.length > 1 ? words[0]![0]! + words[1]![0]! : name.replace(/[^A-Za-z0-9]/g, '').slice(0, 2)).toUpperCase();

let h = 0;
for (const c of id) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const hue = h % 360;
const dims = { sm: 'size-8 text-[0.6875rem] rounded-lg', md: 'size-10 text-xs rounded-[10px]', lg: 'size-14 text-base rounded-xl' }[size];
---

<span
  class:list={['monogram num grid shrink-0 place-items-center font-semibold tracking-tight', dims, className]}
  style={`--h:${hue};${transitionName ? `view-transition-name:${transitionName};` : ''}`}
  aria-hidden="true">{letters}</span
>

<style>
  .monogram {
    background: oklch(0.955 0.025 var(--h));
    color: oklch(0.42 0.09 var(--h));
    box-shadow: inset 0 0 0 1px oklch(0.88 0.04 var(--h));
  }
  :global([data-theme='dark']) .monogram {
    background: oklch(0.24 0.035 var(--h));
    color: oklch(0.86 0.07 var(--h));
    box-shadow: inset 0 0 0 1px oklch(0.32 0.04 var(--h));
  }
</style>
