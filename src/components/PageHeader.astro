---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, description, crumbs } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0" style="background:var(--glow)" aria-hidden="true"></div>
  <div class="container-page relative py-12 md:py-16">
    {
      crumbs && (
        <nav aria-label="Breadcrumb" class="mb-4 text-sm text-subtle">
          <ol class="flex flex-wrap items-center gap-1.5">
            {crumbs.map((c) => (
              <li class="flex items-center gap-1.5">
                <a href={c.href} class="hover:text-fg">
                  {c.label}
                </a>
                <span aria-hidden="true">/</span>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-fg md:text-[2.75rem] md:leading-[1.1]">{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-muted">{description}</p>}
    <slot />
  </div>
</section>
